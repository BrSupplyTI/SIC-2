@model SIC.Web.Models.Pedidos.PedidoBuscaViewModel
@{
    ViewData["Title"] = "Consulta de Pedido";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.2/css/responsive.bootstrap5.min.css" />
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="h4 mb-1">Consulta de Pedido</h2>
                <p class="text-muted mb-0">Pesquise por número do pedido, ordem de compra ou nota fiscal.</p>
            </div>
            <i class="fa-solid fa-magnifying-glass fa-xl text-primary"></i>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="card border-light-subtle">
                    <div class="card-body">
                        <h3 class="h6 mb-3"><i class="fa-duotone fa-file-invoice me-2"></i>Pelo número do pedido</h3>
                        <form asp-controller="Pedidos" asp-action="BuscarPorPedido" method="post" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-8">
                                <label for="InputPedido" class="form-label">Pedido</label>
                                <input type="text" class="form-control" id="InputPedido" name="InputPedido" placeholder="Ex.: 1234567" value="@Model.InputPedido" autofocus>
                            </div>
                            <div class="col-md-4 d-grid">
                                <button name="submit-pedido" type="submit" class="btn btn-primary"><i class="fa-solid fa-search me-2"></i>Pesquisar</button>
                            </div>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(Model.ErroPedido))
                        {
                            <div class="alert alert-danger mt-3 mb-0" role="alert">@Model.ErroPedido</div>
                        }
                    </div>

@if (Model.ShowOcModal && Model.OcPedidos.Count > 1)
{
                        <div class="modal fade" id="ocResultadosModal" tabindex="-1" aria-labelledby="ocResultadosModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="ocResultadosModalLabel">@Model.TotalOcPedidos pedidos encontrados para a OC</h5>                                        
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">                                            
                                            <input type="text" class="form-control" id="ocFiltroInput" placeholder="Filtrar resultados..." />
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-striped table-responsive align-middle" id="ocResultadosTable">
                                                <thead>
                                                    <tr>
                                                        <th class="text-center" data-priority="1">Pedido</th>
                                                        <th class="text-center" data-priority="2">Estabel.</th>
                                                        <th class="text-center" data-priority="7">Data</th>
                                                        <th data-priority="4">Cliente</th>
                                                        <th data-priority="3">Ordem de Compra</th>
                                                        <th data-priority="6">Situação</th>
                                                        <th class="text-end" data-priority="5">Valor Total</th>
                                                        <th class="text-center" data-priority="1">Ver</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.OcPedidos)
                                                    {
                                                        <tr>
                                                            <td class="text-center">@item.PedidoId</td>
                                                            <td class="text-center">@item.EstabelecimentoNome</td>
                                                            <td class="text-center">@item.DataPedido</td>
                                                            <td>@item.ClienteNome</td>
                                                            <td>@item.OrdemCompra</td>
                                                            <td>@item.Situacao</td>
                                                            <td class="text-end">@item.ValorTotalProdutos.ToString("C")</td>
                                                            <td class="text-center">
                                                                <a href="@item.PedidoDetalheUrl" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/responsive.bootstrap5.min.js"></script>
    <script>
        (() => {
            const showModal = @Model.ShowOcModal.ToString().ToLowerInvariant();
            const hasRows = @((Model.OcPedidos?.Count ?? 0) > 1 ? "true" : "false");
            if (!showModal || !hasRows) return;

            const modalEl = document.getElementById('ocResultadosModal');
            const filtroEl = document.getElementById('ocFiltroInput');
            if (!modalEl || typeof DataTable === 'undefined') return;

            const dt = new DataTable('#ocResultadosTable', {
                pageLength: 10,
                responsive: true,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'desc']],
                info: true,
                searching: true,
                scrollCollapse: true,
                paging: true,                            
                responsive: {
                    details: false
                },
                pagingType: 'full_numbers',
                language: {
                    emptyTable: 'Nenhum pedido encontrado.',
                    info: 'Mostrando _START_ até _END_ de _TOTAL_ pedidos',
                    infoEmpty: 'Mostrando 0 até 0 de 0 pedidos',
                    lengthMenu: 'Mostrar _MENU_ pedidos',
                    loadingRecords: 'Carregando...',
                    processing: 'Processando...',
                    search: 'Buscar:',
                    zeroRecords: 'Nenhum pedido corresponde ao filtro',
                    paginate: {
                        first: 'Primeiro',
                        previous: 'Anterior',
                        next: 'Próximo',
                        last: 'Último'
                    }
                }
            });

            if (filtroEl) {
                filtroEl.addEventListener('input', () => dt.search(filtroEl.value || '').draw());
            }

            if (window.bootstrap) {
                new bootstrap.Modal(modalEl).show();
            }
        })();
    </script>
}
                </div>
            </div>

            <div class="col-12">
                <div class="card border-light-subtle">
                    <div class="card-body">
                        <h3 class="h6 mb-3"><i class="fa-duotone fa-receipt me-2"></i>Pela ordem de compra do cliente</h3>
                        <form asp-controller="Pedidos" asp-action="BuscarPorOrdemCompra" method="post" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-8">
                                <label for="InputOrdemCompra" class="form-label">Ordem de compra</label>
                                <input type="text" class="form-control" id="InputOrdemCompra" name="InputOrdemCompra" placeholder="Ex.: OC-99887" value="@Model.InputOrdemCompra">
                            </div>
                            <div class="col-md-4 d-grid">
                                <button name="submit-ordem" type="submit" class="btn btn-primary"><i class="fa-solid fa-search me-2"></i>Pesquisar</button>
                            </div>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(Model.ErroOrdemCompra))
                        {
                            <div class="alert alert-danger mt-3 mb-0" role="alert">@Model.ErroOrdemCompra</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-light-subtle">
                    <div class="card-body">
                        <h3 class="h6 mb-3"><i class="fa-duotone fa-file-lines me-2"></i>Pelo número da nota fiscal</h3>
                        <form asp-controller="Pedidos" asp-action="BuscarPorNotaFiscal" method="post" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-6">
                                <label for="InputNotaFiscal" class="form-label">Nota fiscal</label>
                                <input type="text" class="form-control" id="InputNotaFiscal" name="InputNotaFiscal" placeholder="Ex.: 445566" value="@Model.InputNotaFiscal">
                            </div>
                            <div class="col-md-2">
                                <label for="InputSerieNF" class="form-label">Série</label>
                                <input type="number" class="form-control" id="InputSerieNF" name="InputSerieNF" placeholder="Ex.: 1" value="@Model.InputSerieNF">
                            </div>
                            <div class="col-md-4 d-grid">
                                <button name="submit-nota" type="submit" class="btn btn-primary"><i class="fa-solid fa-search me-2"></i>Pesquisar</button>
                            </div>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(Model.ErroNotaFiscal))
                        {
                            <div class="alert alert-danger mt-3 mb-0" role="alert">@Model.ErroNotaFiscal</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body d-flex justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrow-left me-2"></i>Voltar para a página inicial
        </a>
    </div>
</div>
