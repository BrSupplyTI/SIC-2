    <script>
        (function () {
            document.getElementById('btnLiberar')?.addEventListener('click', async function () {
                const btn = this;
                const originalHtml = btn.innerHTML;

                const dataValidade = document.getElementById('inputDataValidadeFinalizacao')?.value?.trim();
                if (!dataValidade) {
                    Swal.fire({ icon: 'warning', title: 'Atenção', text: 'Informe a data de validade antes de finalizar.' });
                    return;
                }

                btn.disabled = true;
                btn.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Processando...';

                try {
                    const urlFinalizar = cotacaoConfig.urls?.finalizar || `/Cotacao/${cotacaoConfig.propostaId}/finalizar`;
                    const resp = await fetch(urlFinalizar, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            propostaID: cotacaoConfig.propostaId,
                            dataValidade: dataValidade,
                            usuarioID: cotacaoConfig.usuarioId
                        })
                    });

                    const json = await resp.json();

                    if (!resp.ok || !json.success) {
                        throw new Error(json.error ?? `HTTP ${resp.status}`);
                    }

                    bootstrap.Modal.getInstance(document.getElementById('modalFinalizarCotacao'))?.hide();

                    const aguardaAprovacao = json.statusId === 10;
                    await Swal.fire({
                        icon: aguardaAprovacao ? 'info' : 'success',
                        title: aguardaAprovacao ? 'Aguardando Aprovação' : 'Cotação Finalizada!',
                        text: aguardaAprovacao
                            ? 'A margem está fora do intervalo permitido. A cotação foi enviada para aprovação.'
                            : 'A cotação foi finalizada com sucesso.',
                        confirmButtonText: 'OK'
                    });

                    location.reload();
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Erro', text: 'Erro ao finalizar: ' + err.message });
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        })();
    </script>
    <script>
    (function () {
        // ── APROVAR ──
        document.getElementById('btnConfirmarAprovacao')?.addEventListener('click', async function () {
            const btn = this;
            const aprovadorId = parseInt(document.getElementById('inputAprovadorIDAprovacao')?.value ?? '0');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Aprovando...';
            try {
                const urlAprovar = cotacaoConfig.urls?.aprovar || `/Cotacao/${cotacaoConfig.propostaId}/aprovar`;
                const resp = await fetch(urlAprovar, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ aprovadorID: aprovadorId })
                });
                const json = await resp.json();
                if (!resp.ok || !json.success) throw new Error(json.error ?? `HTTP ${resp.status}`);
                bootstrap.Modal.getInstance(document.getElementById('modalAprovacao'))?.hide();
                await Swal.fire({ icon: 'success', title: 'Aprovado!', text: 'Cotação aprovada com sucesso.', confirmButtonText: 'OK' });
                location.reload();
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Erro', text: 'Erro ao aprovar: ' + err.message });
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        // ── REPROVAR ──
        document.getElementById('btnConfirmarReprovacao')?.addEventListener('click', async function () {
            const btn = this;
            const justificativa = document.getElementById('txtJustificativaReprovacao')?.value?.trim();
            if (!justificativa) {
                Swal.fire({ icon: 'warning', title: 'Atenção', text: 'Informe a justificativa da reprovação.' });
                return;
            }
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Reprovando...';
            try {
                const urlReprovar = cotacaoConfig.urls?.reprovar || `/Cotacao/${cotacaoConfig.propostaId}/reprovar`;
                const resp = await fetch(urlReprovar, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ aprovadorID: parseInt(document.getElementById('inputAprovadorIDAprovacao')?.value ?? '0'), justificativa })
                });
                const json = await resp.json();
                if (!resp.ok || !json.success) throw new Error(json.error ?? `HTTP ${resp.status}`);
                bootstrap.Modal.getInstance(document.getElementById('modalReprovacao'))?.hide();
                await Swal.fire({ icon: 'success', title: 'Reprovado', text: 'Cotação reprovada com sucesso.', confirmButtonText: 'OK' });
                location.reload();
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Erro', text: 'Erro ao reprovar: ' + err.message });
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        // ── AUTORIZAR FATURAMENTO ──
        document.getElementById('btnConfirmarAutorizarFaturamento')?.addEventListener('click', async function () {
            const btn = this;
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Autorizando...';
            try {
                const urlAutorizarFaturamento = cotacaoConfig.urls?.autorizarFaturamento || `/Cotacao/${cotacaoConfig.propostaId}/autorizar-faturamento`;
                const resp = await fetch(urlAutorizarFaturamento, {
                    method: 'POST'
                });
                const json = await resp.json();
                if (!resp.ok || !json.success) throw new Error(json.error ?? `HTTP ${resp.status}`);
                bootstrap.Modal.getInstance(document.getElementById('modalAutorizarFaturamento'))?.hide();
                await Swal.fire({ icon: 'success', title: 'Faturamento Autorizado!', text: 'O pedido foi gerado com sucesso.', confirmButtonText: 'OK' });
                location.reload();
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Erro', text: 'Erro ao autorizar faturamento: ' + err.message });
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    })();
    </script>
}
