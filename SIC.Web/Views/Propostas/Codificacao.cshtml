@model SIC.Web.Models.Propostas.CodificacaoViewModel
@{
    ViewData["Title"] = "Proposta: " + Model.CdProposta;
    var podeEditar = new[] { 1, 2, 9 }.Contains(Model.StatusID);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.2/css/responsive.bootstrap5.min.css" />
    <style>
        .info-label { font-size: .82rem; color: var(--sic-muted); }
        .info-value { font-weight: 600; }
        .badge-qualseg { font-size: .78rem; padding: .3rem .6rem; }
        .codif-section-title {
            font-size: .85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: .5rem 1rem;
            background: var(--sic-surface-2);
            border-radius: .5rem;
            margin-bottom: 1rem;
        }
        .table-codif-wrap {
            border: 1px solid var(--sic-border);
            border-radius: .5rem;
            overflow: hidden;
        }
        .table-codif { font-size: .83rem; margin-bottom: 0; }
        .table-codif th { white-space: nowrap; }
        .row-sem-correspondencia { background-color: rgba(var(--bs-danger-rgb), .08) !important; }
        .codif-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .3rem;
            border-radius: .5rem;
            padding: .3rem .65rem;
            font-size: .78rem;
            font-weight: 500;
            border: 1px solid transparent;
            text-decoration: none;
            transition: all .15s ease;
        }
        .codif-btn-manual {
            background: rgba(var(--bs-primary-rgb), .12);
            color: var(--sic-text);
            border-color: rgba(var(--bs-primary-rgb), .3);
        }
        .codif-btn-manual:hover { background: rgba(var(--bs-primary-rgb), .25); }
        .codif-btn-excluir {
            background: rgba(var(--bs-danger-rgb), .12);
            color: var(--sic-text);
            border-color: rgba(var(--bs-danger-rgb), .3);
        }
        .codif-btn-excluir:hover { background: rgba(var(--bs-danger-rgb), .25); }
        .codif-btn-fora-mix {
            background: rgba(var(--bs-danger-rgb), .12);
            color: var(--bs-danger);
            border-color: rgba(var(--bs-danger-rgb), .3);
        }
    </style>
}

<!-- ═══════ CARD RESUMO DA PROPOSTA ═══════ -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h2 class="h4 mb-0">
                    <i class="fa-duotone fa-thin fa-barcode me-2 text-br"></i>@ViewData["Title"]
                </h2>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Propostas" asp-action="Lista" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-list me-1"></i>Lista de Propostas
                </a>
                <a href="javascript:location.reload()" class="btn btn-outline-info btn-sm">
                    <i class="fa-solid fa-rotate-right me-1"></i>Atualizar
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-chevron-left me-1"></i>Voltar
                </a>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <span class="info-label">Nome da Proposta:</span><br>
                <span class="info-value">@Model.NomeProposta</span>
            </div>
            <div class="col-md-3">
                <span class="info-label">Estabelecimento:</span><br>
                <span class="info-value">@Model.NmEstabelecimento</span>
            </div>
            <div class="col-md-3">
                <span class="info-label">Total de Itens:</span><br>
                <span class="info-value" id="TotalItens">@Model.TotalItens</span>
            </div>
            <div class="col-md-3">
                <span class="info-label">Status da Proposta:</span><br>
                <span class="info-value">@Model.NmStatus</span>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <span class="info-label">Qualidades e Segmentos:</span><br>
                @if (Model.QualSeg.Count > 0)
                {
                    @foreach (var qs in Model.QualSeg)
                    {
                        <span class="badge bg-secondary badge-qualseg me-1 mb-1">@qs.Qualidade — @qs.NmSegmento</span>
                    }
                }
                else
                {
                    <span class="text-muted">Nenhum</span>
                }
            </div>
            <div class="col-md-6">
                <span class="info-label">Processo de codificação:</span><br>
                <span class="info-value">@Model.PercentualConcluido</span>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ CARD ITENS DA PROPOSTA ═══════ -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">

        <div class="codif-section-title">
            <i class="fa-duotone fa-list me-1 text-br"></i>Itens da Proposta
        </div>

        @if (podeEditar)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-info btn-sm" id="btnAdicionarItem" data-bs-toggle="modal" data-bs-target="#modalAdicionarItem">
                    <i class="fa-solid fa-plus me-1"></i>Adicionar Item
                </button>
                <button type="button" class="btn btn-success btn-sm" id="btnCodificar" data-bs-toggle="modal" data-bs-target="#modalEscolhaCodificar">
                    <i class="fa-solid fa-robot me-1"></i>Codificar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnGerarExcel">
                    <i class="fa-solid fa-file-excel me-1"></i>Gerar Excel
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalImportacao">
                    <i class="fa-solid fa-arrow-up me-1"></i>Importar Itens
                </button>
            </div>
        }

        <div class="table-codif-wrap">
            <div class="table-responsive">
                <table class="table table-hover table-codif" id="tabelaItens">
                    <thead>
                        <tr>
                            <th class="text-center">ID</th>
                            <th>Descrição Breve</th>
                            <th>Marca</th>
                            <th class="text-center">CA</th>
                            <th class="text-center" style="width:25%;">Item Br Supply</th>
                            <th>Qualidade</th>
                            <th>Custo Aquisição</th>
                            <th class="text-end" style="width:15%;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Itens.Count > 0)
                        {
                            @foreach (var item in Model.Itens)
                            {
                                <tr id="linha-@item.PropostaItemID"
                                    class="@(item.FlagSemCorrespondencia ? "row-sem-correspondencia" : "")"
                                    data-propostaitemid="@item.PropostaItemID"
                                    data-propostaid="@item.PropostaID"
                                    data-descricaobreve="@item.DescricaoBreve"
                                    data-codcliente="@item.CodCliente"
                                    data-numeroca="@item.NumeroCA"
                                    data-familia="@item.Familia"
                                    data-marcafornecedor="@item.MarcaFornecedor"
                                    data-unidademedida="@item.UnidadeMedida"
                                    data-targetformat="@item.TargetFormat"
                                    data-qtdanual="@item.QtdAnual"
                                    data-descricaodetalhada="@item.DescricaoDetalhada"
                                    data-itemid="@item.ItemID">
                                    <td class="text-center">@item.PropostaItemID</td>
                                    <td>@item.DescricaoBreve</td>
                                    <td>@item.NmMarca</td>
                                    <td class="text-center">@item.NumeroCA</td>
                                    <td class="text-center">
                                        @if (item.FlagForaDeMix)
                                        {
                                            <span class="text-danger fw-semibold">Item Fora do Mix</span>
                                        }
                                        else if (item.FlagSemCorrespondencia)
                                        {
                                            <span class="text-danger fw-semibold">Item não localizado</span>
                                        }
                                        else if (item.ItemID.HasValue)
                                        {
                                            <span>@item.CdItem - @item.NmItem</span>
                                        }
                                    </td>
                                    <td>@item.Qualidade</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.VlrCustoAquisicaoFormat))
                                        {
                                            <text>R$@item.VlrCustoAquisicaoFormat</text>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.FlagAddManual)
                                        {
                                            <button type="button" class="codif-btn codif-btn-excluir btnExcluirItem" data-value="@item.PropostaItemID" title="Excluir">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        }
                                        else if (item.FlagForaDeMix)
                                        {
                                            <span class="codif-btn codif-btn-fora-mix" title="Fora de Mix">
                                                <i class="fa-solid fa-xmark"></i> Fora de Mix
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)" class="codif-btn codif-btn-manual btnCodificarManual"
                                               data-propostaitemid="@item.PropostaItemID"
                                               title="Codificador Manual">
                                                <i class="fa-solid fa-user"></i> Manual
                                            </a>
                                            <button type="button" class="codif-btn codif-btn-excluir btnExcluirItem" data-value="@item.PropostaItemID" title="Excluir">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ MODAL: Escolha Codificar ═══════ -->
<div class="modal fade" id="modalEscolhaCodificar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Escolha sua codificação:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="list-unstyled mb-3">
                    <li class="mb-2"><strong>Executar em Tela:</strong><br>O processo de codificação será feito em sua tela, com a contabilização registrada em tempo real.</li>
                    <li><strong>Executar em Segundo Plano:</strong><br>O processo não será feito imediatamente. Ele será executado automaticamente pelo sistema a cada hora.</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" id="btnCodificarEmTela" data-bs-dismiss="modal">
                    <i class="fa-solid fa-desktop me-1"></i>Executar em Tela
                </button>
                <button type="button" class="btn btn-warning" id="btnCodificarSegundoPlano" data-bs-dismiss="modal">
                    <i class="fa-solid fa-clock me-1"></i>Executar em Segundo Plano
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ MODAL: Adicionar Item ═══════ -->
<div class="modal fade" id="modalAdicionarItem" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adicionar Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="addItemFiltro" class="form-label">Filtro</label>
                        <input type="text" id="addItemFiltro" class="form-control" placeholder="Descrição do item...">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" class="btn btn-primary w-100" id="addItemBtnBuscar">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                        </button>
                    </div>
                    <div class="col-md-2"></div>
                    <div class="col-md-2">
                        <label for="addItemQtdAnual" class="form-label">Qtd. Anual</label>
                        <input type="number" id="addItemQtdAnual" class="form-control" min="1" max="1000000" placeholder="1">
                    </div>
                </div>
                <hr>
                <div class="table-responsive">
                    <table class="table table-striped table-sm" id="tableAdicionarItens">
                        <thead>
                            <tr>
                                <th>Probabilidade</th>
                                <th>Cód. do Item</th>
                                <th>Nome do Item</th>
                                <th>Categoria</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ MODAL: Importação ═══════ -->
<div class="modal fade" id="modalImportacao" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Importação de Dados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="file" id="input-excel" class="form-control"
                       accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" />
                <div class="text-center mt-3">
                    <small class="text-muted">Modelo de Importação:</small>
                    <a href="#" id="btnDownloadModelo">Arquivo_Modelo</a>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-success" id="btnImportar">Importar</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="inputPropostaID" value="@Model.PropostaID" />
<input type="hidden" id="inputEstabelecimentoID" value="@Model.EstabelecimentoID" />

<!-- ═══════ MODAL: Codificação Manual ═══════ -->
<div class="modal fade" id="modalCodificacaoManual" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-user me-2"></i>Codificação Manual</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light border mb-3 p-2">
                    <div class="row g-2 small">
                        <div class="col-md-6">
                            <span class="text-muted">Descrição Breve:</span>
                            <strong id="manualDescricaoBreve"></strong>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted">Marca:</span>
                            <strong id="manualMarca"></strong>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted">CA:</span>
                            <strong id="manualCA"></strong>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-8">
                        <input type="text" id="manualFiltro" class="form-control" placeholder="Buscar item no catálogo...">
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary w-100" id="manualBtnBuscar">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-sm" id="tableManualItens">
                        <thead>
                            <tr>
                                <th>Probabilidade</th>
                                <th>Cód. do Item</th>
                                <th>Nome do Item</th>
                                <th>Qualidade</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <script>
        (() => {
            const propostaId = document.getElementById('inputPropostaID').value;
            const estabelecimentoId = document.getElementById('inputEstabelecimentoID').value;
            const pathBase = document.querySelector('meta[name="pathbase"]')?.content || '';

            // DataTable principal
            if ($.fn.DataTable) {
                $('#tabelaItens').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.3.4/i18n/pt-BR.json' },
                    pageLength: 25,
                    order: [[1, 'asc']],
                    columnDefs: [{ orderable: false, targets: -1 }]
                });
            }

            // DataTable do modal Adicionar Item
            let dtAdicionarItens;
            if ($.fn.DataTable) {
                dtAdicionarItens = $('#tableAdicionarItens').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.3.4/i18n/pt-BR.json' },
                    pageLength: 10,
                    ordering: false,
                    searching: false
                });
            }

            var spinnerHtml = '<div class="d-flex justify-content-center align-items-center py-4">' +
                '<div class="spinner-border text-primary" role="status">' +
                    '<span class="visually-hidden">Carregando...</span>' +
                '</div>' +
                '<span class="ms-2 text-muted">Buscando itens...</span>' +
            '</div>';

            // Limpar tabela ao abrir modal
            $('#modalAdicionarItem').on('show.bs.modal', function () {
                if (dtAdicionarItens) {
                    dtAdicionarItens.clear();
                    dtAdicionarItens.rows.add([['<span class="text-muted">Busque por um item...</span>', '', '', '', '']]);
                    dtAdicionarItens.draw();
                }
                $('#addItemFiltro').val('');
                $('#addItemQtdAnual').val('');
            });

            // Buscar itens
            $('#addItemBtnBuscar').on('click', function () {
                const filtro = $('#addItemFiltro').val().trim();

                if (filtro.length < 3) {
                    $('#addItemFiltro').focus();
                    return;
                }

                if (dtAdicionarItens) {
                    dtAdicionarItens.clear().draw();
                    $('#tableAdicionarItens tbody').html(
                        '<tr><td colspan="5" class="text-center">' + spinnerHtml + '</td></tr>'
                    );
                }

                $.ajax({
                    url: pathBase + '/Propostas/BuscarItens',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        estabelecimentoId: estabelecimentoId,
                        filtro: filtro
                    },
                    success: function (data) {
                        if (dtAdicionarItens) {
                            dtAdicionarItens.clear();

                            if (data && data.length > 0) {
                                var rows = [];
                                data.forEach(function (item) {
                                    rows.push([
                                        item.probabilidade,
                                        item.cdItem,
                                        item.nmItem,
                                        item.qualidade,
                                        '<button type="button" class="btn btn-success btn-sm AdicionarItemProposta" data-itemid="' + item.itemID + '">' +
                                            '<i class="fa-solid fa-check"></i>' +
                                        '</button>'
                                    ]);
                                });
                                dtAdicionarItens.rows.add(rows);
                            } else {
                                dtAdicionarItens.rows.add([['Nenhum item encontrado.', '', '', '', '']]);
                            }

                            dtAdicionarItens.draw();
                        }
                    },
                    error: function () {
                        if (dtAdicionarItens) {
                            dtAdicionarItens.clear();
                            dtAdicionarItens.rows.add([['Erro ao buscar itens.', '', '', '', '']]);
                            dtAdicionarItens.draw();
                        }
                    }
                });
            });

            // Buscar ao pressionar Enter no campo filtro
            $('#addItemFiltro').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#addItemBtnBuscar').click();
                }
            });

            // Adicionar item à proposta
            $(document).on('click', '.AdicionarItemProposta', function () {
                const itemId = $(this).data('itemid');
                const qtdAnual = parseInt($('#addItemQtdAnual').val()) || 0;
                const filtro = $('#addItemFiltro').val().trim();

                if (qtdAnual <= 0) {
                    $('#addItemQtdAnual').focus();
                    Swal.fire('Atenção', 'Informe a Quantidade Anual.', 'warning');
                    return;
                }

                $.ajax({
                    url: pathBase + '/Propostas/AdicionarItem',
                    type: 'POST',
                    contentType: 'application/json',
                    dataType: 'json',
                    data: JSON.stringify({
                        propostaID: parseInt(propostaId),
                        itemID: itemId,
                        qtdAnual: qtdAnual,
                        margemPadrao: 30.00,
                        itemFiltro: filtro
                    }),
                    success: function (data) {
                        if (data && data.success) {
                            Swal.fire('Sucesso', 'Item adicionado com sucesso!', 'success').then(function () {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Erro', 'Erro ao adicionar item.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Erro', 'Erro ao adicionar item.', 'error');
                    }
                });
            });

            // Excluir item
            document.querySelectorAll('.btnExcluirItem').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var propostaItemId = this.dataset.value;
                    Swal.fire({
                        title: 'Deseja Excluir?',
                        text: 'Item #' + propostaItemId + ' será removido.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Excluir',
                        cancelButtonText: 'Cancelar'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: pathBase + '/Propostas/ExcluirItem/' + propostaId + '/' + propostaItemId,
                                type: 'DELETE',
                                dataType: 'json',
                                success: function (data) {
                                    if (data && data.success) {
                                        Swal.fire('Excluído!', 'Item removido com sucesso.', 'success').then(function () {
                                            window.location.reload();
                                        });
                                    } else {
                                        Swal.fire('Erro', 'Erro ao excluir item.', 'error');
                                    }
                                },
                                error: function () {
                                    Swal.fire('Erro', 'Erro ao excluir item.', 'error');
                                }
                            });
                        }
                    });
                });
            });

            // ═══ Codificar em Tela ═══
            $('#btnCodificarEmTela').on('click', function () {
                var rows = [];
                var dt = $('#tabelaItens').DataTable();

                dt.rows().every(function () {
                    var node = this.node();
                    var $tr = $(node);
                    var itemId = $tr.data('itemid');
                    var propostaItemId = $tr.data('propostaitemid');
                    if (propostaItemId && (!itemId || itemId === 0 || itemId === '')) {
                        rows.push({ propostaItemId: propostaItemId, el: node });
                    }
                });

                if (rows.length === 0) {
                    Swal.fire('Atenção', 'Não há itens pendentes de codificação.', 'info');
                    return;
                }

                Swal.fire({
                    title: 'Codificando itens...',
                    html: '<div class="mb-2">Processando <strong id="codifAtual">0</strong> de <strong>' + rows.length + '</strong></div>' +
                          '<div class="progress" style="height:20px;"><div class="progress-bar progress-bar-striped progress-bar-animated" id="codifBar" style="width:0%"></div></div>' +
                          '<div class="mt-2 small text-muted" id="codifStatus">Iniciando...</div>',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        var idx = 0;
                        var codificados = 0;
                        var semCorrespondencia = 0;

                        function processNext() {
                            if (idx >= rows.length) {
                                Swal.fire({
                                    title: 'Codificação Concluída!',
                                    html: '<strong>' + codificados + '</strong> codificado(s)<br><strong>' + semCorrespondencia + '</strong> sem correspondência',
                                    icon: 'success'
                                }).then(function () { window.location.reload(); });
                                return;
                            }

                            var item = rows[idx];
                            var pct = Math.round(((idx + 1) / rows.length) * 100);
                            $('#codifAtual').text(idx + 1);
                            $('#codifBar').css('width', pct + '%').text(pct + '%');
                            $('#codifStatus').text('Codificando item #' + item.propostaItemId + '...');

                            $.ajax({
                                url: pathBase + '/Propostas/CodificarItem',
                                type: 'POST',
                                data: { propostaItemId: item.propostaItemId, estabelecimentoId: estabelecimentoId },
                                dataType: 'json',
                                success: function (resp) {
                                    if (resp.codificado) {
                                        codificados++;
                                        dt.cell(item.el, 4).data('<span>' + resp.cdItem + ' - ' + resp.nmItem + '</span>').draw(false);
                                        dt.cell(item.el, 5).data(resp.qualidade || '').draw(false);
                                        $(item.el).removeClass('row-sem-correspondencia');
                                    } else {
                                        semCorrespondencia++;
                                        dt.cell(item.el, 4).data('<span class="text-danger fw-semibold">Item não localizado</span>').draw(false);
                                        $(item.el).addClass('row-sem-correspondencia');
                                    }
                                    idx++;
                                    processNext();
                                },
                                error: function () {
                                    semCorrespondencia++;
                                    idx++;
                                    processNext();
                                }
                            });
                        }

                        processNext();
                    }
                });
            });

            // ═══ Codificar em Segundo Plano ═══
            $('#btnCodificarSegundoPlano').on('click', function () {
                Swal.fire({
                    title: 'Executar em Segundo Plano?',
                    text: 'A proposta será marcada para codificação automática pelo sistema.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Confirmar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: pathBase + '/Propostas/CodificarSegundoPlano',
                        type: 'POST',
                        data: { propostaId: propostaId },
                        dataType: 'json',
                        success: function (resp) {
                            if (resp && resp.success) {
                                Swal.fire('Sucesso', 'Proposta marcada para codificação em segundo plano.', 'success').then(function () {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire('Erro', 'Erro ao marcar codificação.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Erro', 'Erro ao marcar codificação.', 'error');
                        }
                    });
                });
            });

            // ═══ Gerar Excel (exportar dados da tabela) ═══
            $('#btnGerarExcel').on('click', function () {
                var rows = [];
                var dt = $('#tabelaItens').DataTable();

                dt.rows().every(function () {
                    var node = this.node();
                    var $tr = $(node);
                    var itemBrSupply = $.trim($tr.find('td:eq(4)').text());
                    var qualidade = $.trim($tr.find('td:eq(5)').text());
                    var custoAquisicao = $.trim($tr.find('td:eq(6)').text());

                    rows.push({
                        'ID': $tr.data('propostaitemid') || '',
                        'Cod Cliente': $tr.data('codcliente') || '',
                        'Descrição Breve': $tr.data('descricaobreve') || '',
                        'Descrição Detalhada': $tr.data('descricaodetalhada') || '',
                        'Família': $tr.data('familia') || '',
                        'Marca Fornecedor': $tr.data('marcafornecedor') || '',
                        'Unidade Medida': $tr.data('unidademedida') || '',
                        'Qtd Anual': $tr.data('qtdanual') || '',
                        'Target': $tr.data('targetformat') || '',
                        'Nº CA': $tr.data('numeroca') || '',
                        'Item Br Supply': itemBrSupply,
                        'Qualidade': qualidade,
                        'Custo Aquisição': custoAquisicao
                    });
                });

                if (rows.length === 0) {
                    Swal.fire('Atenção', 'Não há itens na tabela para exportar.', 'info');
                    return;
                }

                var ws = XLSX.utils.json_to_sheet(rows);
                ws['!cols'] = [
                    { wch: 8 }, { wch: 15 }, { wch: 30 }, { wch: 40 }, { wch: 20 },
                    { wch: 20 }, { wch: 15 }, { wch: 12 }, { wch: 12 }, { wch: 12 },
                    { wch: 30 }, { wch: 15 }, { wch: 18 }
                ];
                var wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Itens');
                XLSX.writeFile(wb, 'Proposta_' + propostaId + '_Itens.xlsx');
            });

            // ═══ Download modelo Excel ═══
            $('#btnDownloadModelo').on('click', function (e) {
                e.preventDefault();
                var headers = [['CodCliente', 'DescricaoBreve', 'DescricaoDetalhada', 'Familia', 'MarcaFornecedor', 'UnidadeMedida', 'QtdAnual', 'Target']];
                var ws = XLSX.utils.aoa_to_sheet(headers);
                ws['!cols'] = [
                    { wch: 15 }, { wch: 30 }, { wch: 40 }, { wch: 20 },
                    { wch: 20 }, { wch: 15 }, { wch: 12 }, { wch: 12 }
                ];
                var wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Itens');
                XLSX.writeFile(wb, 'Modelo_Importacao_codificador.xlsx');
            });

            // ═══ Importar Excel ═══
            $('#btnImportar').on('click', function () {
                var fileInput = document.getElementById('input-excel');
                if (!fileInput.files || fileInput.files.length === 0) {
                    Swal.fire('Atenção', 'Selecione um arquivo Excel.', 'warning');
                    return;
                }

                var file = fileInput.files[0];
                var reader = new FileReader();

                reader.onload = function (e) {
                    try {
                        var data = new Uint8Array(e.target.result);
                        var workbook = XLSX.read(data, { type: 'array' });
                        var sheet = workbook.Sheets[workbook.SheetNames[0]];
                        var rows = XLSX.utils.sheet_to_json(sheet, { defval: '' });

                        if (!rows || rows.length === 0) {
                            Swal.fire('Atenção', 'A planilha está vazia.', 'warning');
                            return;
                        }

                        var itens = [];
                        for (var i = 0; i < rows.length; i++) {
                            var r = rows[i];
                            var descBreve = (r['DescricaoBreve'] || r['Descricao'] || r['Descrição'] || '').toString().trim();
                            if (!descBreve) continue;

                            itens.push({
                                codCliente: (r['CodCliente'] || r['Cod Cliente'] || r['Codigo'] || '').toString().trim(),
                                descricaoBreve: descBreve,
                                descricaoDetalhada: (r['DescricaoDetalhada'] || r['Descricao Detalhada'] || '').toString().trim(),
                                familia: (r['Familia'] || r['Família'] || '').toString().trim(),
                                marcaFornecedor: (r['MarcaFornecedor'] || r['Marca'] || '').toString().trim(),
                                unidadeMedida: (r['UnidadeMedida'] || r['Unidade'] || r['UN'] || '').toString().trim(),
                                qtdAnual: parseInt(r['QtdAnual'] || r['Qtd Anual'] || r['Quantidade'] || '0') || 0,
                                target: parseFloat(r['Target'] || r['Preço'] || '0') || 0
                            });
                        }

                        if (itens.length === 0) {
                            Swal.fire('Atenção', 'Nenhum item válido encontrado na planilha. Verifique se a coluna "DescricaoBreve" está preenchida.', 'warning');
                            return;
                        }

                        Swal.fire({
                            title: 'Confirmar Importação',
                            text: itens.length + ' item(ns) encontrado(s). Deseja importar?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Importar',
                            cancelButtonText: 'Cancelar'
                        }).then(function (result) {
                            if (!result.isConfirmed) return;

                            Swal.fire({ title: 'Importando...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });

                            $.ajax({
                                url: pathBase + '/Propostas/ImportarItens',
                                type: 'POST',
                                contentType: 'application/json',
                                dataType: 'json',
                                data: JSON.stringify({
                                    propostaID: parseInt(propostaId),
                                    itens: itens
                                }),
                                success: function (resp) {
                                    if (resp && resp.success) {
                                        Swal.fire('Sucesso', resp.inserted + ' item(ns) importado(s) com sucesso!', 'success').then(function () {
                                            window.location.reload();
                                        });
                                    } else {
                                        Swal.fire('Erro', 'Erro ao importar itens.', 'error');
                                    }
                                },
                                error: function () {
                                    Swal.fire('Erro', 'Erro ao importar itens.', 'error');
                                }
                            });
                        });
                    } catch (ex) {
                        Swal.fire('Erro', 'Não foi possível ler o arquivo. Verifique se é um Excel válido.', 'error');
                    }
                };

                reader.readAsArrayBuffer(file);
            });

            // ═══ Codificação Manual ═══
            var dtManualItens;
            if ($.fn.DataTable) {
                dtManualItens = $('#tableManualItens').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.3.4/i18n/pt-BR.json' },
                    pageLength: 10,
                    ordering: false,
                    searching: false
                });
            }

            var manualPropostaItemId = null;

            $(document).on('click', '.btnCodificarManual', function () {
                var $tr = $(this).closest('tr');
                manualPropostaItemId = $tr.data('propostaitemid');

                $('#manualDescricaoBreve').text($tr.data('descricaobreve') || '');
                $('#manualMarca').text($tr.data('marcafornecedor') || '');
                $('#manualCA').text($tr.data('numeroca') || '');
                $('#manualFiltro').val($tr.data('descricaobreve') || '');

                if (dtManualItens) {
                    dtManualItens.clear().draw();
                }

                var modal = new bootstrap.Modal(document.getElementById('modalCodificacaoManual'));
                modal.show();
            });

            $('#modalCodificacaoManual').on('shown.bs.modal', function () {
                if ($('#manualFiltro').val().trim().length >= 3) {
                    $('#manualBtnBuscar').trigger('click');
                }
            });

            $('#manualBtnBuscar').on('click', function () {
                var filtro = $('#manualFiltro').val().trim();
                if (filtro.length < 3) {
                    $('#manualFiltro').focus();
                    return;
                }

                if (dtManualItens) {
                    dtManualItens.clear().draw();
                    $('#tableManualItens tbody').html(
                        '<tr><td colspan="5" class="text-center">' + spinnerHtml + '</td></tr>'
                    );
                }

                $.ajax({
                    url: pathBase + '/Propostas/BuscarItens',
                    type: 'GET',
                    dataType: 'json',
                    data: { estabelecimentoId: estabelecimentoId, filtro: filtro },
                    success: function (data) {
                        if (dtManualItens) {
                            dtManualItens.clear();
                            if (data && data.length > 0) {
                                var rows = [];
                                data.forEach(function (item) {
                                    rows.push([
                                        item.probabilidade,
                                        item.cdItem,
                                        item.nmItem,
                                        item.qualidade,
                                        '<button type="button" class="btn btn-success btn-sm btnVincularItemManual" data-itemid="' + item.itemID + '" data-cditem="' + item.cdItem + '" data-nmitem="' + item.nmItem + '" data-qualidade="' + item.qualidade + '" data-custoacquisicao="' + (item.vlrCustoAquisicaoFormat || '') + '">' +
                                            '<i class="fa-solid fa-check"></i>' +
                                        '</button>'
                                    ]);
                                });
                                dtManualItens.rows.add(rows);
                            } else {
                                dtManualItens.rows.add([['Nenhum item encontrado.', '', '', '', '']]);
                            }
                            dtManualItens.draw();
                        }
                    },
                    error: function () {
                        if (dtManualItens) {
                            dtManualItens.clear();
                            dtManualItens.rows.add([['Erro ao buscar itens.', '', '', '', '']]);
                            dtManualItens.draw();
                        }
                    }
                });
            });

            $('#manualFiltro').on('keypress', function (e) {
                if (e.which === 13) { e.preventDefault(); $('#manualBtnBuscar').trigger('click'); }
            });

            $(document).on('click', '.btnVincularItemManual', function () {
                var itemId = $(this).data('itemid');
                var cdItem = $(this).data('cditem');
                var nmItem = $(this).data('nmitem');
                var qualidade = $(this).data('qualidade');
                var custoAquisicao = $(this).data('custoacquisicao');

                $.ajax({
                    url: pathBase + '/Propostas/VincularItemManual',
                    type: 'POST',
                    dataType: 'json',
                    data: { propostaItemId: manualPropostaItemId, itemId: itemId },
                    success: function (resp) {
                        if (resp && resp.success) {
                            var dt = $('#tabelaItens').DataTable();
                            var rowNode = document.getElementById('linha-' + manualPropostaItemId);

                            dt.cell(rowNode, 4).data('<span>' + cdItem + ' - ' + nmItem + '</span>').draw(false);
                            dt.cell(rowNode, 5).data(qualidade || '').draw(false);
                            dt.cell(rowNode, 6).data(custoAquisicao ? 'R$' + custoAquisicao : '').draw(false);

                            $(rowNode).removeClass('row-sem-correspondencia');
                            $(rowNode).attr('data-itemid', itemId);

                            bootstrap.Modal.getInstance(document.getElementById('modalCodificacaoManual')).hide();
                            Swal.fire('Sucesso', 'Item vinculado com sucesso!', 'success');
                        } else {
                            Swal.fire('Erro', 'Erro ao vincular item.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Erro', 'Erro ao vincular item.', 'error');
                    }
                });
            });
        })();
    </script>
}
