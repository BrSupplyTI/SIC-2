                                                    <td>@item.Codigo</td>
                                                    <td>@item.Descricao</td>
                                                    <td class="text-center">@item.Quantidade</td>
                                                    <td class="text-end">@item.ValorUnitario</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (@Model.Total.QtItensTerceiros > 0)
