        function fmtPair(pct, val) {
        const p = (pct !== null && pct !== undefined) ? Number(pct).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%' : '—';
        const v = (val !== null && val !== undefined) ? 'R$ ' + Number(val).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
        return p + '<br>' + v;
        }
        function fmtPairVal(val1, val2) {
