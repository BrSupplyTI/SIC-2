@model SIC.Web.Models.Cotacao.CotacaoViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = $"Proposta - {Model.CdProposta}";

    var ptBR = new System.Globalization.CultureInfo("pt-BR");

    var data = DateTime.Now;
    var dataFormatada = data.ToString("dd/MM/yyyy HH:mm");
    var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(dataFormatada));

    var (badgeClass, badgeIcon) = Model.StatusID switch
    {
        3 => ("badge-status-success", "fa-solid fa-check"),           // Aprovada
        4 => ("badge-status-danger", "fa-solid fa-times"),            // Recusada
        2 => ("badge-status-warning", "fa-solid fa-hourglass-half"),  // Em Análise
        _ => ("badge-status-primary", "fa-solid fa-chevron-right")    // Aberta ou outros
    };

    bool DeveExibirLocalEntrega()
    {
        static string Normalizar(string? s) => 
            System.Text.RegularExpressions.Regex.Replace(s?.Trim() ?? "", @"\s+", " ");

        var endereco = Normalizar(Model.LocalEntregaEndereco);
        var cidade   = Normalizar(Model.LocalEntregaCidadeEstado);

        var enderecoVazio = string.IsNullOrWhiteSpace(endereco) ||
                            endereco == ", Nº , Bairro: - CEP:" ||
                            endereco == ",Nº,Bairro: -CEP:";

        var cidadeVazia = string.IsNullOrWhiteSpace(cidade) || cidade == "-";

        return !(enderecoVazio && cidadeVazia);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Cotacao/cotacao-view.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />
}

<div class="card border-0 shadow-sm mb-4" data-proposta-id="@Model.PropostaID">
    <div class="card-body p-4 p-lg-5">

        @* ══════════ HEADER ══════════ *@
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h2 class="h4 mb-0">
                        <i class="fa-duotone fa-thin fa-file-invoice-dollar me-2 text-br"></i>Proposta
                    </h2>
                    <span class="badge-status @badgeClass fs-6">
                        <i class="@badgeIcon me-1"></i>@Model.StatusNome
                    </span>
                </div>
                <nav class="prepedido-breadcrumb mt-1">
                    @if (!string.IsNullOrWhiteSpace(Model.OrdemCompra))
                    {
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>Ordem de Compra: <strong>@Model.OrdemCompra</strong></span>
                    }
                </nav>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <a asp-controller="Cotacao" asp-action="Index" class="btn btn-outline-primary">
                    <i class="fa-solid fa-list me-2"></i>Lista de Cotações
                </a>
                @if (Model.StatusID != 7 && Model.StatusID != 3)
                {
                    <a asp-controller="Cotacao" asp-action="Edit" asp-route-propostaId="@Model.PropostaID" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Editar Cotação
                    </a>
                }
                <a href="#" id="btnVoltarCotacao" class="btn btn-outline-dark">
                    <i class="fa-solid fa-arrow-left me-2"></i>Voltar
                </a>
            </div>
        </div>

        @* ══════════ INFORMAÇÕES GERAIS ══════════ *@
        <div class="cotacao-section-title">
            <i class="fa-duotone fa-circle-info me-1 text-br"></i>Informações Gerais
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-warehouse text-br"></i>
                    <div>
                        <small class="text-muted">Estabelecimento</small>
                        <div class="fw-semibold">@Model.EstabelecimentoNome</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-file-invoice-dollar text-br"></i>
                    <div>
                        <small class="text-muted">Tipo de Cotação</small>
                        <div class="fw-semibold">@Model.TipoCotacao</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-calendar-check text-br"></i>
                    <div>
                        <small class="text-muted">Data Validade</small>
                        <div class="fw-semibold">@Model.DataValidade</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-building text-br"></i>
                    <div>
                        <small class="text-muted">Cliente</small>
                        <div class="fw-semibold">@Model.ClienteCodNome</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-id-card text-br"></i>
                    <div>
                        <small class="text-muted">CNPJ</small>
                        <div class="fw-semibold">@Model.ClienteCNPJ</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-check-circle text-br"></i>
                    <div>
                        <small class="text-muted">Contribuinte</small>
                        <div class="fw-semibold">@Model.ClienteContribuinte</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <a href="https://intranet.brsupply.com.br/Intranet/html/edita_localentrega.php?cliente=@Model.ClienteID&local=@Model.ClienteLocalEntregaID" 
                   class="text-decoration-none" 
                   target="_blank"
                   title="Clique para editar o local de entrega">
                    <div class="cotacao-quick-card h-100 clickable-card">
                        <i class="fa-duotone fa-store text-br"></i>
                        <div>
                            <small class="text-muted">Canal de Venda</small>
                            <div class="fw-semibold">
                                @Model.CanalVenda
                                <i class="fa-solid fa-external-link fa-xs ms-1 opacity-75"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-6">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-map-marker-alt text-br"></i>
                    <div>
                        <small class="text-muted">Endereço</small>
                        <div class="fw-semibold">@Model.ClienteEndereco</div>
                    </div>
                </div>
            </div>

            @if (DeveExibirLocalEntrega())
            {
                <div class="col-md-6">
                    <div class="cotacao-quick-card h-100">
                        <i class="fa-duotone fa-location-dot text-br"></i>
                        <div>
                            <small class="text-muted">Local de Entrega</small>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.LocalEntregaEndereco) ? "-" : Model.LocalEntregaEndereco + " | " + Model.LocalEntregaCidadeEstado)</div>
                        </div>
                    </div>
                </div>
            }

            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-file-lines text-br"></i>
                    <div>
                        <small class="text-muted">Tipo de Ordem</small>
                        <div class="fw-semibold">@Model.TipoOrdem</div>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.AprovadorNome))
            {
                <div class="col-md-6 col-xl-4">
                    <div class="cotacao-quick-card h-100">
                        <i class="fa-duotone fa-user-check text-br"></i>
                        <div>
                            <small class="text-muted">Aprovador</small>
                            <div class="fw-semibold">@Model.AprovadorNome</div>
                        </div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Justificativa))
            {
                <div class="col-md-6 col-xl-4">
                    <div class="cotacao-quick-card h-100">
                        <i class="fa-duotone fa-comment-lines text-br"></i>
                        <div>
                            <small class="text-muted">Justificativa</small>
                            <div class="fw-semibold">@Model.Justificativa</div>
                        </div>
                    </div>
                </div>
            }
            </div>

            @* ══════════ PAGAMENTO E CRÉDITO ══════════ *@
        <div class="cotacao-section-title">
            <i class="fa-duotone fa-credit-card me-1 text-br"></i>Pagamento e Crédito
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-calendar-days text-br flex-shrink-0"></i>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-1">
                            <small class="text-muted">Condição de Pagamento</small>
                            @if (Model.StatusID == 1 || Model.StatusID == 14)
                            {
                                <button type="button"
                                        class="btn-obs-edit js-mapping-edit-toggle"
                                        data-target="cotacaoCondPagtoWrapper"
                                        data-display="cotacaoCondPagtoDisplay"
                                        title="Editar Condição de Pagamento">
                                    <i class="fa-solid fa-pencil"></i>
                                </button>
                            }
                        </div>
                        <div id="cotacaoCondPagtoDisplay" class="fw-semibold mapping-display-text mt-1">
                            @(string.IsNullOrWhiteSpace(Model.CondPagtoNome) ? "— Não definida —" : Model.CondPagtoNome)
                        </div>
                        @if (Model.StatusID == 1 || Model.StatusID == 14)
                        {
                            <div id="cotacaoCondPagtoWrapper" class="d-none mt-1">
                                <select id="selectCondPagto"
                                        class="form-select form-select-sm js-cotacao-searchable-select"
                                        data-last-value="@Model.CondPagtoID"
                                        data-placeholder="Digite para pesquisar...">
                                    <option value="">-- Selecione --</option>
                                    @foreach (var opt in Model.CondicoesPagamento)
                                    {
                                        if (opt.Id == Model.CondPagtoID)
                                        {
                                            <option value="@opt.Id" selected>@opt.Nome</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Id">@opt.Nome</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <select id="selectCondPagto" class="d-none" data-last-value="@Model.CondPagtoID" disabled>
                                <option value="@Model.CondPagtoID" selected>@Model.CondPagtoNome</option>
                            </select>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="cotacao-quick-card h-100">
                    <i class="fa-duotone fa-money-check text-br"></i>
                    <div>
                        <small class="text-muted">Forma de Pagamento</small>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.FormaPagamentoDesc) ? "-" : Model.FormaPagamentoDesc)</div>
                    </div>
                </div>
            </div>
            @if (Model.StatusID == 1 || (Model.StatusID == 14 && (Model.TipoCotacao == "Cotação - Revenda" || Model.TipoCotacao == "Cotação - Televendas" || Model.TipoCotacao == "Simulação")))
            {
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Clientes" asp-action="Detalhes" asp-route-id="@Model.ClienteID"
                   class="text-decoration-none" 
                   title="Clique para ver cadastro do cliente">
                    <div class="cotacao-quick-card h-100 clickable-card">
                        <i class="fa-duotone fa-shield-check text-br"></i>
                        <div>
                            <small class="text-muted">Status de Crédito</small>
                            <div class="fw-semibold">
                                @if (Model.StatusCredito == "OK")
                                {
                                    <span class="badge bg-success text-white">
                                        OK
                                        <i class="fa-solid fa-external-link fa-xs ms-1"></i>
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(Model.StatusCredito))
                                {
                                    <span class="badge bg-danger text-white">
                                        @Model.StatusCredito
                                        <i class="fa-solid fa-external-link fa-xs ms-1"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                        <i class="fa-solid fa-external-link fa-xs ms-1 opacity-75"></i>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            }
        </div>

        @* ══════════ MÉTRICAS DO PEDIDO ══════════ *@
        <div class="cotacao-section-title">
            <i class="fa-duotone fa-chart-line me-1 text-br"></i>Métricas do Pedido
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100">
                    <div class="metric-label">Margem Padrão</div>
                    <div class="metric-value">@Model.MargemPadrao.ToString("N1", ptBR)%</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100 bg-info-subtle text-info">
                    <div class="metric-label text-info">Margem Bruta</div>
                    <div class="metric-value">@Model.MargemBruta.ToString("N1", ptBR)%</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100">
                    <div class="metric-label">Total s/ Imposto</div>
                    <div class="metric-value" id="metricTotalSemImposto">@Model.TotalVendaSemImposto</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100 metric-highlight">
                    <div class="metric-label">Total c/ Imposto</div>
                    <div class="metric-value" id="metricTotalComImposto">@Model.TotalVendaFrete</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100">
                    <div class="metric-label">Frete</div>
                    <div class="metric-value">@(string.IsNullOrWhiteSpace(Model.Frete) || Model.Frete == "R$ 0,00" ? "CIF" : Model.Frete)</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-2">
                <div class="cotacao-metric-card h-100">
                    <div class="metric-label">Prazo Entrega</div>
                    <div class="metric-value">@Model.DiasPrazoEntrega dias</div>
                </div>
            </div>

            <div class="col-12">
                @if (Model.StatusID == 1 || (Model.StatusID == 14 && (Model.TipoCotacao == "Pedido - Bonificação" || Model.TipoCotacao == "Comodato" || Model.TipoCotacao == "Pedido - Remessa Reposição" || Model.TipoCotacao == "Transferência" || Model.TipoCotacao == "Cotação - E-Commerce" || Model.TipoCotacao == "Simulação" || Model.TipoCotacao == "Cotação - Televendas" || Model.TipoCotacao == "Cotação - Revenda")))
                {
                    <div class="cotacao-quick-card clickable-card" 
                         data-bs-toggle="modal" 
                         data-bs-target="#modalOpcoesFrete"
                         title="Clique para ver opções de frete">
                        <i class="fa-duotone fa-truck text-br"></i>
                        <div>
                            <small class="text-muted">Transportadora</small>
                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.TransportadoraNome) ? "Clique para calcular frete" : Model.TransportadoraNome)
                                <i class="fa-solid fa-chevron-right fa-xs ms-2 opacity-75"></i>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cotacao-quick-card">
                        <i class="fa-duotone fa-truck text-br"></i>
                        <div>
                            <small class="text-muted">Transportadora</small>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TransportadoraNome) ? "-" : Model.TransportadoraNome)</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ══════════ AÇÕES ══════════ *@
        <div class="cotacao-section-title">
            <i class="fa-duotone fa-bolt me-1 text-br"></i>Ações da Cotação
        </div>

        <div class="cotacao-actions-panel mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                @if (Model.StatusID == 1 || Model.StatusID == 14)
                {
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-warning btn-sm" title="Importar Itens"
                            data-bs-toggle="modal" data-bs-target="#modalImportarItens">
                        <i class="fa-solid fa-file-import me-1"></i>Importar Itens
                    </button>
                    <button type="button" class="btn btn-outline-warning btn-sm" title="Adicionar Item" data-bs-toggle="modal" data-bs-target="#adicionarItemModal">
                        <i class="fa-solid fa-plus me-1"></i>Adicionar Item
                    </button>
                    @if (Model.StatusID == 1)
                    {
                        <button type="button" class="btn btn-outline-warning btn-sm" id="btnCalcularMargem" title="Calcular Margem">
                            <i class="fa-solid fa-calculator me-1"></i>Calcular Margem
                        </button>
                    }
                    <div class="dropdown">
                        <button class="btn btn-outline-info btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Alterar Custo">
                            <i class="fa-solid fa-money-bill-transfer me-1"></i>Alterar Custo
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" id="btnAlterarCustoAqs"><i class="fa-solid fa-receipt me-2"></i>Custo Aquisição</a></li>
                            <li><a class="dropdown-item" href="#" id="btnAlterarCustoMed"><i class="fa-solid fa-chart-line me-2"></i>Custo Médio</a></li>
                        </ul>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Gerar a partir">
                            <i class="fa-solid fa-copy me-1"></i>Gerar a partir
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item btn-gerar" href="#" data-value="C"><i class="fa-solid fa-chart-area me-2"></i>Com base no Consumo</a></li>
                            <li><a class="dropdown-item btn-gerar" href="#" data-value="U"><i class="fa-solid fa-history me-2"></i>Último Pedido</a></li>
                            <li><a class="dropdown-item btn-gerar" href="#" data-value="P"><i class="fa-solid fa-box me-2"></i>Outro Pedido</a></li>
                                        </ul>
                                    </div>
                                    <a href="https://intranet.brsupply.com.br/intranet/html/crm/edita_crm_contato.php?cliente=@Model.ClienteID" target="_blank" class="btn btn-outline-primary btn-sm" title="Registro de CRM">
                                        <i class="fa-solid fa-clipboard-list me-1"></i>Registro de CRM
                                    </a>
                                </div>
                                }
                else
                {
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.StatusID == 2)
                    {
                        <a asp-controller="Cotacao" asp-action="Enviar" asp-route-propostaId="@Model.PropostaID" class="btn btn-outline-success btn-sm" title="Enviar Cotação">
                            <i class="fa-solid fa-paper-plane me-1"></i>Enviar E-mail
                        </a>
                    }
                    <a href="https://intranet.brsupply.com.br/intranet/html/crm/edita_crm_contato.php?cliente=@Model.ClienteID" target="_blank" class="btn btn-outline-secondary btn-sm" title="Registro de CRM">
                        <i class="fa-solid fa-clipboard-list me-1"></i>Registro de CRM
                    </a>
                </div>
                }
            </div>
        </div>

        @* ══════════ ITENS DA COTAÇÃO ══════════ *@
        <div class="cotacao-section-title mb-1">
            <i class="fa-duotone fa-boxes-stacked me-1 text-br"></i>Itens da Cotação
        </div>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="input-group input-group-sm" style="width:220px;">
                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="inputFiltroItens" class="form-control" placeholder="Buscar Item..." />
            </div>
            <div id="itensPagination" class="catalogo-pagination d-none"></div>
        </div>

        <div class="table-cotacao-wrap mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-cotacao mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 40px;"><input type="checkbox" class="form-check-input" id="checkAllItens" /></th>
                            <th style="width: 120px;">Cód. Item BR</th>
                            <th>Descrição Item BR</th>
                            <th class="text-center" style="width: 100px;">Estoque Disp.</th>
                            <th class="text-end" style="width: 100px;">Preço Mín.</th>
                            <th class="text-end" style="width: 100px;">Tbl. Preço</th>
                            <th class="text-center" style="width: 90px;">Margem (%)</th>
                            <th style="width: 200px;">Custo Líquido</th>
                            <th class="text-end" style="width: 100px;">Preço Un.</th>
                            <th class="text-center" style="width: 100px;">Quantidade</th>
                            <th class="text-center" style="width: 80px;">ICMS</th>
                            <th class="text-end" style="width: 100px;">Valor IPI</th>
                            <th class="text-end" style="width: 100px;">Valor ST</th>
                            <th class="text-end" style="width: 120px;">Total c/ Imp.</th>
                            <th class="text-center" style="width: 90px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyCotacaoItens">
                        <tr>
                            <td colspan="15" class="text-center py-4">
                                <i class="fa-duotone fa-spinner fa-spin fa-2x mb-2 text-muted"></i>
                                <div class="text-muted">Carregando itens...</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @* ══════════ RODAPÉ DE AÇÕES ══════════ *@
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pt-3 border-top">
            <div class="d-flex gap-2">
                @if (Model.StatusID == 1 || Model.StatusID == 14)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btnRemoverSelecionados">
                        <i class="fa-solid fa-trash-can me-1"></i>Remover Selecionados
                    </button>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-center">
