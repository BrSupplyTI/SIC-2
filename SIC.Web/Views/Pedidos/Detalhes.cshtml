                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (@Model.Total.QtItensRuptura > 0)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingItensRuptura">
                        <button class="accordion-button fw-semibold collapsed text-danger" type="button" data-bs-toggle="collapse" data-bs-target="#collapseItensRuptura" aria-expanded="false" aria-controls="collapseItensRuptura">
                            <i class="fa-duotone fa-thin fa-wine-glass-crack me-3 pedido-accordion-icon"></i> Rupturas de Estoque
                            <span class="badge rounded-pill bg-danger ms-2">@Model.Total.QtItensRuptura</span>
                        </button>
                    </h2>
                    <div id="collapseItensRuptura" class="accordion-collapse collapse" aria-labelledby="headingItensRuptura" data-bs-parent="#pedidoDetalhesAccordion">
                        <div class="accordion-body">
                            @if (Model.Itens.Count == 0)
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fa-duotone fa-box-open fa-2x mb-2 d-block"></i>
                                    Nenhum item encontrado.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped align-middle mb-0">
                                        <thead><tr><th>Código</th><th>Descrição</th><th class="text-center">Qtd</th><th class="text-end">Vlr. Unit.</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in Model.Itens)
                                            {
                                                <tr>
                                                    <td>@item.Codigo</td>
                                                    <td>@item.Descricao</td>
                                                    <td class="text-center">@item.Quantidade</td>
                                                    <td class="text-end">@item.ValorUnitario</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingAprovacao">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAprovacao" aria-expanded="false" aria-controls="collapseAprovacao">
                        <i class="fa-duotone fa-thin fa-gavel me-3 pedido-accordion-icon"></i> Logs de Aprovação
                        <span class="badge rounded-pill bg-secondary ms-2">@Model.LogsAprovacao.Count</span>
                    </button>
                </h2>
                <div id="collapseAprovacao" class="accordion-collapse collapse" aria-labelledby="headingAprovacao" data-bs-parent="#pedidoDetalhesAccordion">
                    <div class="accordion-body">
                        @if (Model.LogsAprovacao.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fa-duotone fa-clipboard-list fa-2x mb-2 d-block"></i>
                                Nenhum log de aprovação registrado.
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var log in Model.LogsAprovacao)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start">
                                        <span><strong>@log.Usuario</strong> — @log.Acao</span>
                                        <small class="text-muted text-nowrap ms-3">@log.DataHora</small>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingObservacoes">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseObservacoes" aria-expanded="false" aria-controls="collapseObservacoes">
                        <i class="fa-duotone fa-thin fa-message me-3 pedido-accordion-icon"></i> Observações
                    </button>
                </h2>
                <div id="collapseObservacoes" class="accordion-collapse collapse" aria-labelledby="headingObservacoes" data-bs-parent="#pedidoDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="cad-row">
                            <div class="cad-label text-muted">Observação do Solicitante</div>
                            <div class="cad-info"> @Model.Observacao.ObsCotacao</div>
                        </div>
                        <div class="cad-row">
                            <div class="cad-label text-muted">Observação do Aprovador</div>
                            <div class="cad-info"> @Model.Observacao.ObsAprovacao</div>
                        </div>
                        <div class="cad-row">
                            <div class="cad-label text-muted">Observação para Nota Fiscal</div>
                            <div class="cad-info"> @Model.Observacao.ObsNota</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingNf">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNf" aria-expanded="false" aria-controls="collapseNf">
                        <i class="fa-duotone fa-thin fa-file-invoice me-3 pedido-accordion-icon"></i> Notas Fiscais
                        <span class="badge rounded-pill bg-secondary ms-2">@Model.NotasFiscaisRelacionadas.Count</span>
                    </button>
                </h2>
                <div id="collapseNf" class="accordion-collapse collapse" aria-labelledby="headingNf" data-bs-parent="#pedidoDetalhesAccordion">
                    <div class="accordion-body">
                        @if (Model.NotasFiscaisRelacionadas.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fa-duotone fa-file-circle-xmark fa-2x mb-2 d-block"></i>
                                Nenhuma nota fiscal relacionada.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead><tr><th>Número</th><th>Série</th><th>Emissão</th></tr></thead>
                                    <tbody>
                                        @foreach (var nf in Model.NotasFiscaisRelacionadas)
                                        {
                                            <tr>
                                                <td>@nf.Numero</td>
                                                <td>@nf.Serie</td>
                                                <td>@nf.Emissao</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTracking">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTracking" aria-expanded="false" aria-controls="collapseTracking">
                        <i class="fa-duotone fa-thin fa-map-location me-3 pedido-accordion-icon"></i> Tracking
                        <span class="badge rounded-pill bg-secondary ms-2">@Model.Trackings.Count</span>
                    </button>
                </h2>
                <div id="collapseTracking" class="accordion-collapse collapse" aria-labelledby="headingTracking" data-bs-parent="#pedidoDetalhesAccordion">
                    <div class="accordion-body">
                        @{
                            var setor = Model.Header.Setor?.ToUpperInvariant() ?? "";
                            var isCancelado = setor is "CANCELADO" or "ERRO";
                            var etapa1 = isCancelado ? "incomplete"
                                       : setor is "CLIENTE" or "COMERCIAL" or "DISTRIBUIÇÃO" or "FATURAMENTO" or "OPERAÇÃO" or "TRANSPORTE" or "ENTREGUE" ? "complete" : "";
                            var etapa2 = setor is "DISTRIBUIÇÃO" or "FATURAMENTO" or "OPERAÇÃO" or "TRANSPORTE" or "ENTREGUE" ? "complete" : "";
                            var etapa3 = setor is "TRANSPORTE" or "ENTREGUE" ? "complete" : "";
                            var etapa4 = setor == "ENTREGUE" ? "complete" : "";
                        }

                        <div class="pedido-timeline my-4">
                            <div class="pedido-timeline-track">
                                <div class="pedido-timeline-step @etapa1">
                                    <div class="pedido-timeline-dot"></div>
                                    <span class="pedido-timeline-label">Pedido</span>
                                </div>
                                <div class="pedido-timeline-bar @etapa2"></div>
                                <div class="pedido-timeline-step @etapa2">
                                    <div class="pedido-timeline-dot"></div>
                                    <span class="pedido-timeline-label">Operação</span>
                                </div>
                                <div class="pedido-timeline-bar @etapa3"></div>
                                <div class="pedido-timeline-step @etapa3">
                                    <div class="pedido-timeline-dot"></div>
                                    <span class="pedido-timeline-label">Transporte</span>
                                </div>
                                <div class="pedido-timeline-bar @etapa4"></div>
                                <div class="pedido-timeline-step @etapa4">
                                    <div class="pedido-timeline-dot"></div>
                                    <span class="pedido-timeline-label">Entregue</span>
                                </div>
                            </div>
                        </div>

                        @if (Model.Trackings.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fa-duotone fa-map-location-dot fa-2x mb-2 d-block"></i>
                                Nenhum evento de tracking registrado.
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var tr in Model.Trackings)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start">
                                        <span>@tr.Evento — @tr.Local</span>
                                        <small class="text-muted text-nowrap ms-3">@tr.DataHora</small>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="totalizadores-section mt-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="fa-duotone fa-calculator text-br fa-lg"></i>
                <h5 class="mb-0 fw-semibold">Totalizadores</h5>
            </div>
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <div class="border rounded-3 p-3 bg-body-tertiary totalizador-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-duotone fa-boxes-stacked text-br"></i>
                            <small class="text-muted">Itens Br Supply</small>
                        </div>
                        <p class="fw-semibold mb-0 totalizador-valor">R$ @Model.Total.ValorItensBRSupply.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="border rounded-3 p-3 bg-body-tertiary totalizador-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-duotone fa-store text-br"></i>
                            <small class="text-muted">Itens Marketplace</small>
                        </div>
                        <p class="fw-semibold mb-0 totalizador-valor">R$ @Model.Total.ValorItensTerceiros.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="border rounded-3 p-3 bg-body-tertiary totalizador-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-duotone fa-truck text-br"></i>
                            <small class="text-muted">Valor do Frete</small>
                        </div>
                        <p class="fw-semibold mb-0 totalizador-valor">R$ @Model.Total.VlrFrete.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="border rounded-3 p-3 bg-body-tertiary totalizador-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-duotone fa-wrench text-br"></i>
                            <small class="text-muted">Valor do Serviço</small>
                        </div>
                        <p class="fw-semibold mb-0 totalizador-valor">R$ @Model.Total.VlrTaxaServico.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))</p>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <div class="border rounded-3 p-3 totalizador-card totalizador-total">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-duotone fa-coins fa-lg"></i>
                                <span class="fw-semibold fs-6">Valor Total do Pedido</span>
                            </div>
                            <span class="fw-bold fs-4 totalizador-total-valor">R$ 0,00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
