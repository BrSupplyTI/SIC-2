                                <div class="tit-filter-bar mb-2" id="usuariosFilterBar"></div>
                                <div class="table-responsive">
                                    <table class="table table-sm styled-table align-middle mb-0" id="tblUsuarios" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th data-priority="6" class="text-center">ID</th>
                                                <th data-priority="2" class="text-center">Situação</th>
                                                <th data-priority="1" class="text-center">Login</th>
                                                <th data-priority="7" class="text-center">Nome do Usuário</th>
                                                <th data-priority="5" class="text-center">E-mail</th>
                                                <th data-priority="3" class="text-start">Perfil</th>
                                                <th data-priority="9" class="text-center">Catálogo</th>
                                                <th data-priority="8" class="text-start">Permissão</th>
                                                <th data-priority="10" class="text-center">Data Cadastro</th>
                                                <th data-priority="4" class="text-center">Último Login</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Saldo de Crédito -->
<div class="modal fade" id="modalSaldoCredito" tabindex="-1" aria-labelledby="modalSaldoCreditoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSaldoCreditoLabel"><i class="fa-duotone fa-calculator me-2"></i>Saldo de Crédito Disponível</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="text-center text-muted py-4" id="saldoCreditoLoader">
                    <div class="spinner-border text-primary mb-2" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <div>Calculando saldo...</div>
                </div>
                <div class="alert alert-danger d-none" id="saldoCreditoError" role="alert">
                    Não foi possível carregar o saldo de crédito.
                </div>
                <div class="d-none" id="saldoCreditoContent">
                    <div class="saldo-formula">
                        <div class="saldo-formula-row">
                            <span class="saldo-formula-label">Limite de Crédito</span>
                            <span class="saldo-formula-op"></span>
                            <span class="saldo-formula-value text-primary fw-semibold" id="scLimite">R$ 0,00</span>
                        </div>
                        <div class="saldo-formula-row">
                            <span class="saldo-formula-label">Créditos (Antecipação)</span>
                            <span class="saldo-formula-op text-success">+</span>
                            <span class="saldo-formula-value text-success" id="scCreditos">R$ 0,00</span>
                        </div>
                        <div class="saldo-formula-row">
                            <span class="saldo-formula-label">Títulos em Aberto</span>
                            <span class="saldo-formula-op text-danger">−</span>
                            <span class="saldo-formula-value text-danger" id="scTitulos">R$ 0,00</span>
                        </div>
                        <div class="saldo-formula-row">
                            <span class="saldo-formula-label">Pedidos Não Faturados</span>
                            <span class="saldo-formula-op text-danger">−</span>
                            <span class="saldo-formula-value text-danger" id="scPedidos">R$ 0,00</span>
                        </div>
                        <hr class="my-2" />
                        <div class="saldo-formula-row saldo-formula-total">
                            <span class="saldo-formula-label fw-bold">Saldo Disponível</span>
                            <span class="saldo-formula-op">=</span>
                            <span class="saldo-formula-value fw-bold fs-5" id="scSaldo">R$ 0,00</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.1/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.4/js/responsive.bootstrap5.min.js"></script>
    <script>
        window.clienteConfig = {
        basePath: '@Url.Content("~/")'.replace(/\/$/, ''),
        clienteId: @Model.ClienteID,
        vlrLimiteCredito: @Model.VlrLimiteCredito.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
    </script>
    <script src="~/js/clientes/detalhes.js" asp-append-version="true"></script>
}
