@page
@model SIC.Web.Pages.Account.LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login SIC";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="cards shadow-sm bg-transparent">            
            <img class="logo-login" src="~/img/logo-dark.png" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm opacity-75">
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post" class="mb-3">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Input.Login" class="form-label">Login</label>
                        <input asp-for="Input.Login" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Login" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Senha</label>
                        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>

                <hr />

                <form method="post" asp-page-handler="Azure">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <button type="submit" class="btn btn-outline-primary w-100">Entrar com Microsoft</button>
                </form>

                <form method="post" class="mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-page="/Account/ForgotPassword">Esqueci a senha</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
