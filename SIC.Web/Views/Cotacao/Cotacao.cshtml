                            <i class="fa-solid fa-envelope me-1"></i>Abrir Chamado
                        </button>
                    }
                }
                @if (Model.StatusID == 10 && Model.PodeAprovar)
                {
                    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalAprovacao" title="Aprovar Cotação">
