                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fi fi-us rounded-1" style="font-size:1.1rem;"></span>
                            <span class="fw-semibold">Dólar (USD)</span>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold">R$ 5,47</span>
                            <br /><small class="text-success"><i class="fa-solid fa-caret-down me-1"></i>-0,32%</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fi fi-eu rounded-1" style="font-size:1.1rem;"></span>
                            <span class="fw-semibold">Euro (EUR)</span>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold">R$ 6,15</span>
                            <br /><small class="text-danger"><i class="fa-solid fa-caret-up me-1"></i>+0,18%</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card border-0 h-100">
                <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2">
                    <i class="fa-duotone fa-rocket text-br"></i>
                    <strong>Atalhos Rápidos</strong>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6 col-md-4">
                            <a asp-controller="Pedidos" asp-action="Busca" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-magnifying-glass fa-lg mb-1"></i>
                                Consultar Pedido
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a asp-controller="Account" asp-action="MeusDados" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-id-card fa-lg mb-1"></i>
                                Meus Dados
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="#" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-chart-mixed fa-lg mb-1"></i>
                                Relatórios
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="#" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-user-tie fa-lg mb-1"></i>
                                Clientes
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="#" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-truck-fast fa-lg mb-1"></i>
                                Logística
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="https://intranet.brsupply.com.br/intranet/html/valida_login.php?u=@User.FindFirst("sic_login")?.Value&h=@base64" target="_blank" class="btn btn-outline-br w-100 d-flex flex-column align-items-center gap-1 py-3" style="font-size:.85rem;">
                                <i class="fa-duotone fa-globe fa-lg mb-1"></i>
                                SIC Antigo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card border-0">
                <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2">
                    <i class="fa-duotone fa-clock-rotate-left text-br"></i>
                    <strong>Últimas Atividades</strong>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
