@model SIC.Web.Models.Clientes.ClienteDetalhesViewModel
@{
    ViewData["Title"] = $"{Model.CodigoSAP} - {Model.Nome}";

    var isAtivo = string.Equals(Model.Situacao, "Ativo", StringComparison.OrdinalIgnoreCase);
    var isCpf = string.Equals(Model.TipoDocumento, "CPF", StringComparison.OrdinalIgnoreCase);

    var badgeCreditoClass = Model.StatusCredito switch
    {
        "Bloqueado" => "badge-credito-bloqueado",
        "Análise Vencida" => "badge-credito-vencida",
        "Crédito Normal" => "badge-credito-normal",
        "Somente Pagamento A Vista" => "badge-credito-avista",
        _ => "badge-credito-liberado"
    };

    var ptBR = new System.Globalization.CultureInfo("pt-BR");

    (string Label, string Icon, string BadgeText, string BadgeIcon, string BadgeClass)
        BoolCfg(string label, string icon, bool ativo) => ativo
            ? (label, icon, "Sim", "fa-check", "bg-success-subtle text-success-emphasis")
            : (label, icon, "Não", "fa-xmark", "bg-secondary-subtle text-secondary-emphasis");

    var (trocaItemTexto, trocaItemBadge) = Model.FlagTrocaItemAutomatica switch
    {
        1 => ("Apenas homologados", "bg-warning-subtle text-warning-emphasis"),
        2 => ("Qualquer troca", "bg-success-subtle text-success-emphasis"),
        _ => ("Não permite", "bg-secondary-subtle text-secondary-emphasis")
    };

    var (tipoConcatTexto, tipoConcatBadge) = Model.FlagTipoConcat switch
    {
        1 => ("Por CNPJs / endereços", "bg-info-subtle text-info-emphasis"),
        2 => ("Por cód. controle do local", "bg-primary-subtle text-primary-emphasis"),
        _ => ("Por ID do local", "bg-secondary-subtle text-secondary-emphasis")
    };

    var configSections = new (string Title, string TitleIcon,
        (string Label, string Icon, string BadgeText, string BadgeIcon, string BadgeClass)[] Items)[]
    {
        ("Integrações Automáticas", "fa-solid fa-rocket", new[]
        {
            BoolCfg("Integração automática SAP",   "fa-solid fa-rotate",         Model.FlagIntegracaoAutomaticaSAP == 1),
            BoolCfg("Liberação automática",         "fa-solid fa-circle-check",   Model.FlagUtilizaLiberacaoAutomatica == 1),
            BoolCfg("Programação automática",       "fa-solid fa-calendar-check", Model.FlagProgramacaoAutomatica == 1)
        }),

        ("Configurações Gerais", "fa-solid fa-sliders", new[]
        {
            BoolCfg("Janela de corte",              "fa-solid fa-scissors",       Model.FlagUtilizaJanelaCorte == 1),
            BoolCfg("Agrupar frete por CNPJ",       "fa-solid fa-truck",          Model.FlagFreteAgrupCNPJ == 1),
            BoolCfg("Validação fiscal",              "fa-solid fa-file-invoice",   Model.FlagValidacaoFiscal == 1),
            BoolCfg("Valida impostos troca item",    "fa-solid fa-receipt",        Model.FlagValidaImpostosTrocaItem == 1),
            BoolCfg("OC obrigatória nos pedidos",    "fa-solid fa-file-contract",  Model.FlagNaoLiberarPedidoSemOC == 1),
            BoolCfg("Bloquear edição com OC",        "fa-solid fa-lock",           Model.FlagNaoEditarPedidoComOC == 1),
            BoolCfg("Política de entregas",          "fa-solid fa-dolly",          Model.FlagPoliticaEntrega == 1)
        }),

        ("Multi-CD", "fa-solid fa-warehouse", new[]
        {
            BoolCfg("Faturamento de qualquer CD",    "fa-solid fa-building",       Model.FlagMultiCD == 1),
            BoolCfg("Endereços p/ CD mais próximo",  "fa-solid fa-map-pin",        Model.FlagMultiCDEnderecos == 1),
            BoolCfg("Pedidos p/ CD com estoque",     "fa-solid fa-boxes-stacked",  Model.FlagMultiCDPedidos == 1)
        }),

        ("Troca de Itens", "fa-solid fa-arrow-right-arrow-left", new[]
        {
            ("Troca automática",                     "fa-solid fa-shuffle",           trocaItemTexto, "", trocaItemBadge),
            BoolCfg("Não valida DE/PARA",            "fa-solid fa-ban",               Model.FlagNaoValidaTrocaItem == 1),
            BoolCfg("Não valida NCM diferente",      "fa-solid fa-file-circle-xmark", Model.FlagNaoValidaNCMTrocaItem == 1)
        }),

        ("Concatenação de Pedidos", "fa-solid fa-object-group", new[]
        {
            BoolCfg("Concatenação automática",       "fa-solid fa-link",                  Model.FlagAutoConcat == 1),
            BoolCfg("Apenas com Ordem de Compra",    "fa-solid fa-file-circle-check",     Model.FlagOrdemCompra == 1),
            ("Tipo de concatenação",                  "fa-solid fa-sitemap",               tipoConcatTexto, "", tipoConcatBadge),
            BoolCfg("Concatenar pedidos ruptura",    "fa-solid fa-triangle-exclamation",  Model.FlagConcatPedidoRuptura == 1),
            BoolCfg("Isentar frete ao concatenar",   "fa-solid fa-truck-fast",            Model.FlagAutoIsentaFrete == 1),
            BoolCfg("Priorizar perfil solicitante",  "fa-solid fa-user-check",            Model.FlagPrioConcatPerfilSolicitante == 1),
            BoolCfg("Itens marketplace juntos",      "fa-solid fa-handshake",             Model.FlagConcatItemFornecedor == 1),
            BoolCfg("Isolar categorias",             "fa-solid fa-layer-group",           Model.FlagConcatIsolarCategorias == 1)
        })
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/clientes/detalhes.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.1/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.4/css/responsive.bootstrap5.min.css" />
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">

        <!-- Header -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
            <div class="cliente-header">
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <div class="cliente-logo">
                        <img src="@Model.LogoUrl" alt="Logo @Model.Nome" />
                    </div>
                }
                else if (isCpf)
                {
                    <div class="cliente-avatar">
                        <i class="fa-duotone fa-user-tie"></i>
                    </div>
                }
                else if (Model.QtUsuarios > 0)
                {
                    <div class="cliente-avatar-success">
                        <i class="fa-duotone fa-buildings"></i>
                    </div>
                }
                else
                {
                    <div class="cliente-avatar">
                        <i class="fa-duotone fa-building"></i>
                    </div>
                }
                <div class="cliente-header-info">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="cliente-codigo">@Model.CodigoSAP</span>
                    </div>
                    <h4 class="cliente-header-nome mt-1">@Model.RazaoSocial</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.Nome))
                    {
                        <p class="cliente-header-razao mb-0">@Model.Nome</p>
                    }
                    <div class="cliente-header-meta mt-1">
                        @if (!string.IsNullOrWhiteSpace(Model.ClienteMae))
                        {
                            <span><i class="fa-solid fa-chevron-circle-down"></i>Este cliente tem um cliente mãe [@Model.ClienteMae]</span>
                        }
                        @if (Model.QtUsuarios > 0)
                        {
                            <span><i class="fa-solid fa-chevron-circle-up"></i>Este cliente é um cliente mãe</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Estado))
                        {
                            <span><i class="fa-solid fa-map-location-dot"></i>@Model.Estado</span>
                        }
                    </div>
                </div>
            </div>
            <a asp-controller="Clientes" asp-action="Busca" class="btn btn-outline-primary flex-shrink-0">
                <i class="fa-solid fa-arrow-left me-2"></i>Voltar à busca
            </a>
        </div>

        <!-- Stat cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="cliente-stat-card">
                    <div class="cliente-stat-icon @(isAtivo ? "text-success" : "text-danger")"><i class="fa-duotone @(isAtivo ? "fa-check-circle" : "fa-times-circle")"></i></div>
                    <div class="cliente-stat-number @(isAtivo ? "text-success" : "text-danger") text-uppercase">@Model.Situacao</div>
                    <div class="cliente-stat-text">Situação</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="cliente-stat-card">
                    <div class="cliente-stat-icon text-primary"><i class="fa-duotone fa-map-location-dot"></i></div>
                    <div class="cliente-stat-number text-primary">@Model.QtEnderecos</div>
                    <div class="cliente-stat-text">Endereços</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="cliente-stat-card">
                    <div class="cliente-stat-icon text-primary"><i class="fa-duotone fa-home-alt"></i></div>
                    <div class="cliente-stat-number text-primary">@Model.QtLocaisEntrega</div>
                    <div class="cliente-stat-text">Locais de Entrega</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="cliente-stat-card">
                    <div class="cliente-stat-icon text-info"><i class="fa-duotone fa-users"></i></div>
                    <div class="cliente-stat-number text-info">@Model.QtUsuarios</div>
                    <div class="cliente-stat-text">Usuários</div>
                </div>
            </div>
        </div>
        <div class="row g-4">
            <!-- Coluna esquerda: Informações do Cliente -->
            <div class="col-lg-6">
                <div class="cliente-section-title">
                    <i class="fa-duotone fa-user-tie text-br"></i>Informações do Cliente
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Estabelecimento</div>
                    <div class="cad-info">@Model.NmEstabelecimento <span class="text-muted">(@Model.CdEstabelecimento)</span></div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Carteira</div>
                    <div class="cad-info">@Model.NmCarteira <span class="text-muted">(@Model.CarteiraID)</span></div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Canal de Venda</div>
                    <div class="cad-info">@Model.NmCanalVenda <span class="text-muted">(@Model.CanalVendaID)</span></div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">@Model.TipoDocumento</div>
                    <div class="cad-info">@Model.CPFCNPJ</div>
                </div>
                @if (@Model.TipoDocumento != "CPF")
                {
                    <div class="cad-row">
                        <div class="cad-label text-muted">Inscrição Estadual</div>
                        <div class="cad-info">@Model.InscrEstadual</div>
                    </div>
                }
                <div class="cad-row">
                    <div class="cad-label text-muted">Telefone</div>
                    <div class="cad-info">@Model.TelefoneCliente</div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Cond. Pagamento</div>
                    <div class="cad-info">@Model.NmCondPagto</div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Canal de Distribuição SAP</div>
                    <div class="cad-info">@Model.NmCanalDistribuicaoSAP</div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Tipo de Documento SAP</div>
                    <div class="cad-info">@Model.TipoDocumentoSAP - @Model.DsTipoDocumentoSAP</div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Forma de Pagamento SAP</div>
                    <div class="cad-info">@Model.CodFormaPagamentoSAP - @Model.DsFormaPagamentoSAP</div>
                </div>
            </div>
            <!-- Coluna direita: Configurações -->
            <div class="col-lg-6">
                <div class="cliente-section-title">
                    <i class="fa-duotone fa-file-signature text-br"></i>Informações de Contrato
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Canal de Venda</div>
                    <div class="cad-info">@Model.NmTblPreco <span class="text-muted">(@Model.TblPrecoID)</span></div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Segmento</div>
                    <div class="cad-info">@Model.SegmentoCliente</div>
                </div>
                <div class="cad-row">
                    <div class="cad-label text-muted">Perfil</div>
                    <div class="cad-info">@Model.NmClientePerfil</div>
                </div>
                @if (Model.TipoDocumento != "CPF")
                {
                    <div class="cliente-section-title mt-4">
                        <i class="fa-duotone fa-landmark-dome text-br"></i>Informações Legais
                    </div>
                    <div class="cad-row">
                        <div class="cad-label text-muted">Cód. Nat. Jurídica</div>
                        <div class="cad-info">@Model.CdNatJuridica</div>
                    </div>
                    <div class="cad-row">
                        <div class="cad-label text-muted">Desc. Nat. Jurídica</div>
                        <div class="cad-info">@Model.DsNatJuridica</div>
                    </div>
                    <div class="cad-row">
                        <div class="cad-label text-muted">CNAE</div>
                        <div class="cad-info">@Model.Cnae</div>
                    </div>
                    <div class="cad-row">
                        <div class="cad-label text-muted">CNAE Setor</div>
                        <div class="cad-info">@Model.CodCnaeSetor</div>
                    </div>
                    <div class="cad-row">
                        <div class="cad-label text-muted">Descrição CNAE</div>
                        <div class="cad-info">@Model.DsCnaeSetor</div>
                    </div>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Coluna: Consultores que atendem o cliente -->
            <div class="col-lg-12">
                <div class="cliente-section-title mt-4">
                    <i class="fa-duotone fa-user-headset text-br"></i>Consultores
                </div>

                @if (Model.Consultores.Count == 0)
                {
                    <p class="text-muted mb-0">Nenhum consultor vinculado a este cliente.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var consultor in Model.Consultores)
                        {
                            <div class="cad-avatar">
                                <p class="m-0 fs-8 text-muted">@consultor.Cargo</p>
                                <div class="list-group-item d-flex align-items-center gap-3 py-1">
                                    @if (!string.IsNullOrWhiteSpace(consultor.FotoUrl))
                                    {
                                        <img class="avatar-user" src="@consultor.FotoUrl" alt="@consultor.NmUsuario" title="@consultor.NmUsuario" />
                                    }
                                    else
                                    {
                                        <div class="avatar-user d-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold" style="font-size:.85rem">
                                            @(consultor.NmUsuario.Length > 0 ? consultor.NmUsuario[0] : '?')
                                        </div>
                                    }
                                    <div>
                                        @consultor.NmUsuario <br />
                                        <small class="text-muted">@consultor.Email</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="accordion mt-4" id="clienteDetalhesAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingConfig">
                    <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConfig" aria-expanded="true" aria-controls="collapseConfig">
                        <i class="fa-duotone fa-thin fa-cog me-3 produto-accordion-icon"></i> Configurações
                    </button>
                </h2>
                <div id="collapseConfig" class="accordion-collapse collapse show" aria-labelledby="headingConfig" data-bs-parent="#clienteDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="d-flex flex-column gap-2">
                            @{
                                var isFirstGroup = true;
                            }
                            @foreach (var grp in configSections)
                            {
                                <p class="fw-semibold cliente-section-title @(isFirstGroup ? "" : "mt-2") mb-0">
                                    <i class="text-br text-uppercase @grp.TitleIcon me-1"></i>@grp.Title
                                </p>
                                <div class="row">
                                    @{
                                        isFirstGroup = false;
                                        foreach (var cfg in grp.Items)
                                        {
                                            <div class="cliente-config-item col-md-5 mx-2 mb-1">
                                                <span class="cliente-config-label">
                                                    <i class="@cfg.Icon"></i>@cfg.Label
                                                </span>
                                                <span class="badge @cfg.BadgeClass">
                                                    @if (!string.IsNullOrEmpty(cfg.BadgeIcon))
                                                    {
                                                        <i class="fa-solid @cfg.BadgeIcon me-1"></i>
                                                    }
                                                    @cfg.BadgeText
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingCredito">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCredito" aria-expanded="false" aria-controls="collapseCredito">
                        <i class="fa-duotone fa-thin fa-money-bill-trend-up me-3 produto-accordion-icon"></i> Informações de Crédito
                    </button>
                </h2>
                <div id="collapseCredito" class="accordion-collapse collapse" aria-labelledby="headingCredito" data-bs-parent="#clienteDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="row g-4">
                            <!-- Coluna esquerda: Crédito -->
                            <div class="col-lg-12">
                                <div class="cliente-section-title">
                                    <i class="fa-duotone fa-credit-card text-br"></i>Informações de Crédito
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-12">
                                        <div class="cliente-info-card d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <div class="cliente-info-label">Status do Crédito</div>
                                                <div class="cliente-info-value">
                                                    <span class="badge-credito @badgeCreditoClass">@Model.StatusCredito</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSaldoCredito">
                                                <i class="fa-solid fa-calculator me-1"></i>Saldo Disponível
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Perfil de Crédito</div>
                                            <div class="cad-info">@(string.IsNullOrWhiteSpace(Model.NmPerfilCredito) ? "—" : Model.NmPerfilCredito)</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Tipo de Controle</div>
                                            <div class="cad-info">@(string.IsNullOrWhiteSpace(Model.TipoControle) ? "—" : Model.TipoControle)</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Limite de Crédito</div>
                                            <div class="cad-info">@Model.VlrLimiteCredito.ToString("C2", ptBR)</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Atraso Permitido</div>
                                            <div class="cad-info">@Model.DiasAtrasoPermitido dia(s)</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Data da Análise</div>
                                            <div class="cad-info">@(Model.DtAnaliseCredito ?? "—")</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Vencimento da Análise</div>
                                            <div class="cad-info">
                                                @(Model.DtVencAnaliseCredito ?? "—")
                                                @if (Model.DiasRestantes < 0)
                                                {
                                                    <span class="text-danger ms-1">(@Math.Abs(Model.DiasRestantes)d vencida)</span>
                                                }
                                                else if (Model.DiasRestantes <= 30 && Model.DtVencAnaliseCredito is not null)
                                                {
                                                    <span class="text-warning ms-1">(@(Model.DiasRestantes)d restantes)</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        <div class="cad-row">
                                            <div class="cad-label text-muted">Duração da Análise</div>
                                            <div class="cad-info">@Model.MesesDuracaoAnalise meses</div>
                                        </div>
                                    </div>
                                    <div class="col-xl-6">
                                        @if (!string.IsNullOrEmpty(Model.ResponsavelAnaliseCredito))
                                        {
                                            <div class="cad-avatar ms-2">
                                                <p class="m-0 fs-8 text-muted">Responsável pela Análise de Credito</p>
                                                <div class="list-group-item d-flex align-items-center gap-3 py-1">
                                                    @if (!string.IsNullOrWhiteSpace(Model.FotoResponsavelAnaliseCredito))
                                                    {
                                                        <img class="avatar-user" src="/img/upload/@Model.FotoResponsavelAnaliseCredito" alt="@Model.ResponsavelAnaliseCredito" title="@Model.ResponsavelAnaliseCredito" />
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-user d-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold" style="font-size:.85rem">
                                                            @Model.ResponsavelAnaliseCredito[0]
                                                        </div>
                                                    }
                                                    <div>
                                                        @Model.ResponsavelAnaliseCredito <br />
                                                        <small class="text-muted">@Model.EmailResponsavelAnaliseCredito</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cliente-info-card">
                                                <div class="cliente-info-label">Responsável pela Análise de Crédito</div>
                                                <div class="cliente-info-value text-muted">Não definido</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTitulos">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTitulos" aria-expanded="false" aria-controls="collapseTitulos">
                        <i class="fa-duotone fa-thin fa-file-invoice-dollar me-3 produto-accordion-icon"></i> Títulos em Aberto
                    </button>
                </h2>
                <div id="collapseTitulos" class="accordion-collapse collapse" aria-labelledby="headingTitulos" data-bs-parent="#clienteDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="text-center text-muted py-4 d-none" id="titulosLoader">
                            <div class="spinner-border text-primary mb-2" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <div>Carregando dados...</div>
                        </div>
                        <div class="alert alert-danger d-none" id="titulosError" role="alert">
                            Não foi possível carregar os títulos em aberto.
                        </div>
                        <div class="alert alert-secondary d-none" id="titulosEmpty">
                            Nenhum título em aberto encontrado.
                        </div>
                        <div class="d-none" id="divTblTitulos">
