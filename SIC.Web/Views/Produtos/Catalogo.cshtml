@model SIC.Web.Models.Produtos.ProdutoCatalogoViewModel
@{
    ViewData["Title"] = "Catálogo de Produtos";

    var orderByOptions = new[]
    {
        "Nome (A-Z)", "Nome (Z-A)",
        "Código (Crescente)", "Código (Decrescente)",
        "Estoque (Crescente)", "Estoque (Decrescente)",
        "Data Cadastro (Recente)", "Data Cadastro (Antigo)"
    };

    var estSelecionado = Model.Estabelecimentos.FirstOrDefault(e => e.EstabelecimentoID == Model.EstabelecimentoID);
    var totalFiltrosAtivos = (Model.FlagAtivo != 1 ? 1 : 0)
        + (Model.FlagSustentavel == 1 ? 1 : 0) + (Model.FlagNovidade == 1 ? 1 : 0)
        + (Model.FlagOutlet == 1 ? 1 : 0) + (!string.IsNullOrWhiteSpace(Model.Curva) ? 1 : 0)
        + (Model.FlagMarcaPropria == 1 ? 1 : 0) + (Model.FlagComEstoque == 1 ? 1 : 0)
        + (Model.FlagSobDemanda != 2 ? 1 : 0) + (Model.FlagPadraoBrSupply != 1 ? 1 : 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/produtos/catalogo.css" asp-append-version="true" />
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">

        <!-- Header -->
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <h2 class="h4 mb-0"><i class="fa-duotone fa-thin fa-pump-soap me-2 text-br"></i>Catálogo de Produtos</h2>                    
                </div>
                <p class="text-muted mt-1 mb-0">
                    <strong>@Model.TotalRegistros.ToString("N0", new System.Globalization.CultureInfo("pt-BR"))</strong> produto(s) encontrado(s)
                </p>
            </div>
        </div>        

        <!-- Busca & Controles -->
        <form method="get" asp-controller="Produtos" asp-action="Catalogo" id="formCatalogo">
            <input type="hidden" name="page" id="inputPage" value="@Model.PageNumber" />
            <input type="hidden" name="flagAtivo" id="inputFlagAtivo" value="@Model.FlagAtivo" />
            <input type="hidden" name="flagMarcaPropria" id="inputFlagMarcaPropria" value="@Model.FlagMarcaPropria" />
            <input type="hidden" name="estabelecimentoId" id="inputEstabelecimentoId" value="@Model.EstabelecimentoID" />
            <input type="hidden" name="flagOutlet" id="inputFlagOutlet" value="@Model.FlagOutlet" />
            <input type="hidden" name="flagSobDemanda" id="inputFlagSobDemanda" value="@Model.FlagSobDemanda" />
            <input type="hidden" name="flagSustentavel" id="inputFlagSustentavel" value="@Model.FlagSustentavel" />
            <input type="hidden" name="flagNovidade" id="inputFlagNovidade" value="@Model.FlagNovidade" />
            <input type="hidden" name="curva" id="inputCurva" value="@Model.Curva" />
            <input type="hidden" name="flagPadraoBrSupply" id="inputFlagPadraoBrSupply" value="@Model.FlagPadraoBrSupply" />
            <input type="hidden" name="flagComEstoque" id="inputFlagComEstoque" value="@Model.FlagComEstoque" />

            <div class="row g-2 mb-3">
                <div class="col-12 col-lg-5">
                    <small class="text-muted">Pesquisar por nome ou código</small>
                    <div class="input-group">
                        <select class="form-select catalogo-tipo-busca" name="tipoBusca" id="selectTipoBusca">
                            <option value="comeca" selected="@(Model.TipoBusca == "comeca")">Começa com</option>
                            <option value="contem" selected="@(Model.TipoBusca == "contem")">Contém</option>
                        </select>
                        <input type="text" class="form-control" name="texto" value="@Model.Texto"
                               placeholder="Código, nome ou CA..." id="inputTexto" />
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <small class="text-muted">Ordem</small>
                    <select class="form-select h-45px" name="orderBy" id="selectOrderBy"
                            onchange="document.getElementById('inputPage').value=1;document.getElementById('formCatalogo').submit();">
                        @foreach (var opt in orderByOptions)
                        {
                            <option value="@opt" selected="@(Model.OrderBy == opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <small class="text-muted">Por página</small>
                    <select class="form-select h-45px" name="pageSize" id="selectPageSize"
                            onchange="document.getElementById('inputPage').value=1;document.getElementById('formCatalogo').submit();">
                        @foreach (var size in new[] { 10, 20, 30, 40, 50, 60 })
                        {
                            <option value="@size" selected="@(Model.PageSize == size)">@size itens</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1 position-relative mt-4" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFiltros">
                        <i class="fa-solid fa-sliders me-1"></i>Filtros
                        @if (totalFiltrosAtivos > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@totalFiltrosAtivos</span>
                        }
                    </button>
                    <a asp-controller="Produtos" asp-action="Catalogo" class="btn btn-outline-danger mt-4" title="Limpar filtros">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>

        <!-- Filtros ativos -->
        <div class="d-flex flex-wrap gap-2 mb-4" id="activeFilters">
            @if (estSelecionado is not null)
            {
                <span class="badge-status badge-status-primary">
                    <i class="fa-solid fa-warehouse me-1"></i>@estSelecionado.NmEstabelecimento
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Texto))
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('texto','')">
                    <i class="fa-solid fa-search me-1"></i>"@Model.Texto"<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagAtivo != 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagAtivo','1')">
                    @(Model.FlagAtivo == 0 ? "Inativos" : "Todos os status")<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagSustentavel == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagSustentavel','0')">
                    <i class="fa-solid fa-leaf me-1"></i>Sustentável<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagNovidade == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagNovidade','0')">
                    <i class="fa-solid fa-sparkles me-1"></i>Novidade<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagOutlet == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagOutlet','2')">
                    <i class="fa-solid fa-tag me-1"></i>Outlet<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagSobDemanda == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagSobDemanda','2')">
                    <i class="fa-solid fa-clock me-1"></i>Sob Demanda<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Curva))
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('curva','')">
                    Curva @Model.Curva<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagMarcaPropria == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagMarcaPropria','0')">
                    <i class="fa-solid fa-tag me-1"></i>Marca Própria<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagComEstoque == 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagComEstoque','0')">
                    <i class="fa-solid fa-boxes-stacked me-1"></i>Com Estoque<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
            @if (Model.FlagPadraoBrSupply != 1)
            {
                <span class="badge-status badge-status-primary catalogo-filter-tag" onclick="removeFilter('flagPadraoBrSupply','1')">
                    <i class="fa-solid fa-circle-xmark me-1"></i>Todo o Mix<i class="fa-solid fa-xmark ms-2"></i>
                </span>
            }
        </div>

        <!-- Grid de produtos -->
        @if (Model.Itens.Count == 0)
        {
            <div class="text-center py-5">                
                <h5 class="text-muted">Nenhum produto encontrado</h5>
                <p class="text-muted mb-3">Tente ajustar os filtros ou o termo de busca.</p>
                <a asp-controller="Produtos" asp-action="Catalogo" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-rotate-left me-1"></i>Limpar filtros
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-3" id="catalogGrid">
                @foreach (var item in Model.Itens)
                {
                    var temEstoque = item.QtEstoque > 0;

                    <div class="col">
                        <a href="@Url.Action("Detalhes", "Produtos", new { itemId = item.ItemID })" class="text-decoration-none">
                        <div class="card catalogo-card h-100">
                            <!-- Badges -->
                            <div class="catalogo-badges">
                                @if (item.FlagTipoMarca == "Marca Própria")
                                {
                                    <span class="catalogo-badge-mp" title="Marca Própria">MP</span>
                                }
                            </div>

                            <!-- Curva indicator -->
                            @if (!string.IsNullOrWhiteSpace(item.Curva))
                            {
                                <span class="catalogo-curva catalogo-curva-@item.Curva.ToLower()" title="Curva">@item.Curva</span>
                            }

                            <!-- Imagem -->
                            <div class="catalogo-img-wrapper">
                                <img src="@item.Foto" alt="@item.NmItem" class="catalogo-img" loading="lazy"
                                     onerror="this.src='https://www.supplymanager.com.br/fotos/semimagem.jpg'" />
                            </div>

                            <!-- Conteúdo -->
                            <div class="card-body d-flex flex-column px-3 pt-2 pb-3">
                                <span class="catalogo-codigo">@item.CdItem</span>
                                <h6 class="catalogo-nome">@item.NmItem</h6>

                                <div class="catalogo-meta mt-auto">
                                    @if (!string.IsNullOrWhiteSpace(item.NmMarca))
                                    {
                                        <span><i class="fa-solid fa-tag"></i>@item.NmMarca</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.NumCA))
                                    {
                                        <span><i class="fa-solid fa-certificate"></i>CA @item.NumCA</span>
                                    }
                                    <span><i class="fa-solid fa-layer-group"></i>@item.NmSegmento</span>
                                </div>
                            </div>

                            <!-- Estoque footer -->
                            <div class="catalogo-stock @(temEstoque ? "catalogo-stock-ok" : "catalogo-stock-out")">
                                <i class="fa-solid @(temEstoque ? "fa-check-circle" : "fa-times-circle")"></i>
                                <span>@(temEstoque ? item.QtEstoque.ToString("N0", new System.Globalization.CultureInfo("pt-BR")) + " un." : "Indisponível")</span>
                            </div>
                        </div>
                        </a>
                    </div>
                }
            </div>

            <!-- Paginação -->
            @if (Model.TotalPaginas > 1)
            {
                var totalPages = Model.TotalPaginas;
                var currentPage = Model.PageNumber;
                var startPage = Math.Max(1, currentPage - 2);
                var endPage = Math.Min(totalPages, currentPage + 2);

                <div class="catalogo-pagination mt-4">
                    <small class="text-muted">
                        Página <strong>@currentPage</strong> de <strong>@totalPages</strong>
                        — @Model.Itens.Count de @Model.TotalRegistros.ToString("N0", new System.Globalization.CultureInfo("pt-BR")) produtos
                    </small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage(1)"><i class="fa-solid fa-angles-left"></i></a>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage(@(currentPage - 1))"><i class="fa-solid fa-angle-left"></i></a>
                        </li>
                        @for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="javascript:void(0)" onclick="goToPage(@p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage(@(currentPage + 1))"><i class="fa-solid fa-angle-right"></i></a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage(@totalPages)"><i class="fa-solid fa-angles-right"></i></a>
                        </li>
                    </ul>
                </div>
            }
        }
    </div>
</div>

<!-- Offcanvas de Filtros -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasFiltros" aria-labelledby="offcanvasFiltrosLabel">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasFiltrosLabel" class="mb-0"><i class="fa-duotone fa-sliders me-2 text-br"></i>Filtros Avançados</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div class="flex-grow-1">
            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-toggle-on me-1 text-muted"></i>Situação</label>
                <select class="form-select" id="filtroAtivo">
                    <option value="1" selected="@(Model.FlagAtivo == 1)">Ativos</option>
                    <option value="0" selected="@(Model.FlagAtivo == 0)">Inativos</option>
                    <option value="2" selected="@(Model.FlagAtivo == 2)">Todos</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-warehouse me-1 text-muted"></i>Estabelecimento</label>
                <select class="form-select" id="filtroEstabelecimento">
                    @foreach (var est in Model.Estabelecimentos)
                    {
                        <option value="@est.EstabelecimentoID" selected="@(Model.EstabelecimentoID == est.EstabelecimentoID)">@est.NmEstabelecimento</option>
                    }
                </select>
                <small class="text-danger mt-1" id="AlertaEstoque" style="display:@(Model.EstabelecimentoID == 0 ? "block" : "none")">
                    <i class="fa-solid fa-exclamation-circle me-2"></i> Soma o estoque de todos os estabelecimentos
                </small>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-chart-simple me-1 text-muted"></i>Curva ABC</label>
                <select class="form-select" id="filtroCurva">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Curva))">Todas</option>
                    <option value="A" selected="@(Model.Curva == "A")">Curva A</option>
                    <option value="B" selected="@(Model.Curva == "B")">Curva B</option>
                    <option value="C" selected="@(Model.Curva == "C")">Curva C</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-percent me-1 text-muted"></i>Outlet</label>
                <select class="form-select" id="filtroOutlet">
                    <option value="2" selected="@(Model.FlagOutlet == 2)">Todos</option>
                    <option value="1" selected="@(Model.FlagOutlet == 1)">Apenas Outlet</option>
                    <option value="0" selected="@(Model.FlagOutlet == 0)">Exceto Outlet</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold"><i class="fa-solid fa-clock me-1 text-muted"></i>Sob Demanda</label>
                <select class="form-select" id="filtroSobDemanda">
                    <option value="2" selected="@(Model.FlagSobDemanda == 2)">Todos</option>
                    <option value="1" selected="@(Model.FlagSobDemanda == 1)">Apenas Sob Demanda</option>
                    <option value="0" selected="@(Model.FlagSobDemanda == 0)">Exceto Sob Demanda</option>
                </select>
            </div>

            <hr class="my-3" />

            <div class="mb-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="filtroSustentavel" @(Model.FlagSustentavel == 1 ? "checked" : "")>
                    <label class="form-check-label" for="filtroSustentavel">
                        <i class="fa-solid fa-leaf text-success me-1"></i>Apenas Sustentável
                    </label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="filtroNovidade" @(Model.FlagNovidade == 1 ? "checked" : "")>
                    <label class="form-check-label" for="filtroNovidade">
                        <i class="fa-solid fa-sparkles text-info me-1"></i>Apenas Novidade
                    </label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="filtroPadraoBr" @(Model.FlagPadraoBrSupply == 1 ? "checked" : "")>
                    <label class="form-check-label" for="filtroPadraoBr">
                        <i class="fa-solid fa-check-circle text-br me-1"></i>Apenas Mix BrSupply
                    </label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="filtroMarcaPropria" @(Model.FlagMarcaPropria == 1 ? "checked" : "")>
                    <label class="form-check-label" for="filtroMarcaPropria">
                        <i class="fa-solid fa-tag text-primary me-1"></i>Apenas Marca Própria
                    </label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="filtroComEstoque" @(Model.FlagComEstoque == 1 ? "checked" : "")>
                    <label class="form-check-label" for="filtroComEstoque">
                        <i class="fa-solid fa-boxes-stacked text-success me-1"></i>Apenas com Estoque
                    </label>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 pt-3 border-top">
            <button type="button" class="btn btn-primary" id="btnAplicarFiltros">
                <i class="fa-solid fa-check me-1"></i>Aplicar Filtros
            </button>
            <button type="button" class="btn btn-outline-secondary" id="btnLimparFiltros">
                <i class="fa-solid fa-eraser me-1"></i>Limpar Tudo
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function goToPage(page) {
            document.getElementById('inputPage').value = page;
            document.getElementById('formCatalogo').submit();
        }

        var filterInputMap = {
            texto: 'inputTexto',
            flagAtivo: 'inputFlagAtivo',
            flagMarcaPropria: 'inputFlagMarcaPropria',
            flagOutlet: 'inputFlagOutlet',
            flagSobDemanda: 'inputFlagSobDemanda',
            flagSustentavel: 'inputFlagSustentavel',
            flagNovidade: 'inputFlagNovidade',
            curva: 'inputCurva',
            flagPadraoBrSupply: 'inputFlagPadraoBrSupply',
            flagComEstoque: 'inputFlagComEstoque'
        };

        function removeFilter(field, defaultValue) {
            var inputId = filterInputMap[field];
            if (!inputId) return;
            var el = document.getElementById(inputId);
            if (el) el.value = defaultValue;
            document.getElementById('inputPage').value = '1';
            document.getElementById('formCatalogo').submit();
        }

        document.getElementById('btnAplicarFiltros')?.addEventListener('click', function () {
            document.getElementById('inputFlagAtivo').value = document.getElementById('filtroAtivo').value;
            document.getElementById('inputFlagMarcaPropria').value = document.getElementById('filtroMarcaPropria').checked ? '1' : '0';
            document.getElementById('inputEstabelecimentoId').value = document.getElementById('filtroEstabelecimento').value;
            document.getElementById('inputCurva').value = document.getElementById('filtroCurva').value;
            document.getElementById('inputFlagOutlet').value = document.getElementById('filtroOutlet').value;
            document.getElementById('inputFlagSobDemanda').value = document.getElementById('filtroSobDemanda').value;
            document.getElementById('inputFlagSustentavel').value = document.getElementById('filtroSustentavel').checked ? '1' : '0';
            document.getElementById('inputFlagNovidade').value = document.getElementById('filtroNovidade').checked ? '1' : '0';
            document.getElementById('inputFlagPadraoBrSupply').value = document.getElementById('filtroPadraoBr').checked ? '1' : '0';
            document.getElementById('inputFlagComEstoque').value = document.getElementById('filtroComEstoque').checked ? '1' : '0';
            document.getElementById('inputPage').value = '1';
            document.getElementById('formCatalogo').submit();
        });

        document.getElementById('btnLimparFiltros')?.addEventListener('click', function () {
            window.location.href = '@Url.Action("Catalogo", "Produtos")';
        });

        document.getElementById('filtroEstabelecimento')?.addEventListener('change', function () {
            document.getElementById('AlertaEstoque').style.display = this.value === '0' ? 'block' : 'none';
        });
    </script>
}
