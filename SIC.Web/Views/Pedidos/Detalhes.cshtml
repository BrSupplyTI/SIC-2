    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/responsive.bootstrap5.min.js"></script>
    <script>
        window.pedidoConfig = {
        pedidoId: @Model.PedidoId,
        numeroPedido: '@Model.Header.NumeroPedido',
        endpoints: {
        integracaoSap: '@Url.Action("IntegracaoSap", "Pedidos", new { pedido = Model.PedidoId })',
        analiseCredito: '@Url.Action("AnaliseCredito", "Pedidos", new { pedido = Model.PedidoId })',
        itensBrSupply: '@Url.Action("ItensBrSupply", "Pedidos", new { pedido = Model.PedidoId })',
        itensMarketplace: '@Url.Action("ItensMarketplace", "Pedidos", new { pedido = Model.PedidoId })',
        itensBrRuptura: '@Url.Action("ItensBrRuptura", "Pedidos", new { pedido = Model.PedidoId })',
        logsAprovacao: '@Url.Action("LogsAprovacao", "Pedidos", new { pedido = Model.PedidoId })',
        notasFiscais: '@Url.Action("NotasFiscais", "Pedidos", new { pedido = Model.PedidoId })',
        downloadXml: '@Url.Action("DownloadInvoiceXml", "Pedidos", new { chave = "__CHAVE__" })',
        volumesColeta: '@Url.Action("VolumesColeta", "Pedidos")',
        romaneios: '@Url.Action("Romaneios", "Pedidos", new { pedido = Model.PedidoId })',
        logsTracking: '@Url.Action("LogsTracking", "Pedidos", new { pedido = Model.PedidoId })',
        chamados: '@Url.Action("Chamados", "Pedidos", new { pedido = Model.PedidoId })',
        impostos: '@Url.Action("Impostos", "Pedidos", new { pedido = Model.PedidoId })',
        historicoFrete: '@Url.Action("HistoricoFrete", "Pedidos", new { pedido = Model.PedidoId })',
        calculoFrete: '@Url.Action("CalculoFrete", "Pedidos", new { pedido = Model.PedidoId })',
        registrosLogs: '@Url.Action("RegistrosLogs", "Pedidos", new { pedido = Model.PedidoId })',
        validacoes: '@Url.Action("Validacoes", "Pedidos", new { pedido = Model.PedidoId })'
        }
        };
    </script>
    <script src="~/js/pedidos/detalhes.js"></script>
}
