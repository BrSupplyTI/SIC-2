@model IReadOnlyList<SIC.Web.Areas.Projetos.Models.ProjetoHistoricoItemVm>

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Nenhum registro de histórico.</p>
}
else
{
    <div class="historico-timeline">
        @foreach (var h in Model.OrderByDescending(x => x.ProjetoHistoricoID))
        {
            <div class="historico-item">
                <div class="historico-acao">
                    <span class="historico-usuario">@h.NmUsuario</span> @h.DsAcao
                </div>
                <div class="historico-data">
                    <i class="fa-solid fa-clock me-1"></i>@h.DtAcao
                </div>
            </div>
        }
    </div>
}
