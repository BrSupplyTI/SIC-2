                    <i class="fa-duotone fa-cake-candles text-br"></i>
                    <strong>Aniversariantes do Dia</strong>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="rounded-circle bg-body-tertiary d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                <i class="fa-duotone fa-user text-muted"></i>
                            </div>
                            <div>
                                <p class="mb-0 fw-semibold">Maria Silva</p>
                                <small class="text-muted">Comercial</small>
                            </div>
                            <span class="ms-auto" style="font-size:1.2rem;">🎂</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="rounded-circle bg-body-tertiary d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                <i class="fa-duotone fa-user text-muted"></i>
                            </div>
                            <div>
                                <p class="mb-0 fw-semibold">João Pereira</p>
                                <small class="text-muted">Logística</small>
                            </div>
                            <span class="ms-auto" style="font-size:1.2rem;">🎂</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="rounded-circle bg-body-tertiary d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                <i class="fa-duotone fa-user text-muted"></i>
                            </div>
                            <div>
                                <p class="mb-0 fw-semibold">Ana Souza</p>
