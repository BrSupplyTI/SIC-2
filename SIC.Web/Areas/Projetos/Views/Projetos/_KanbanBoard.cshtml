@model SIC.Web.Areas.Projetos.Models.ProjetoDetalhesViewModel
@{
    var podeEditar = ViewData["PodeEditar"] is true;

    // Only root tasks go into Kanban columns; subtasks are rendered inside their parent card
    var rootTasks = Model.Tarefas.Where(t => t.ProjetoTarefaPaiID is null).ToList();

    var statusColumns = Model.TarefaStatusDisponiveis.OrderBy(s => s.NrOrdem).ToList();

    // "Concluído" status by name for progress calculation
    var concluidoStatusId = statusColumns.FirstOrDefault(s =>
        s.NmStatus.Equals("Concluído", StringComparison.OrdinalIgnoreCase))?.ProjetoTarefaStatusID
        ?? statusColumns.LastOrDefault()?.ProjetoTarefaStatusID ?? 0;

    // Serialize status list so JS can build dropdown menus
    var statusListJson = System.Text.Json.JsonSerializer.Serialize(
        statusColumns.Select(s => new { id = s.ProjetoTarefaStatusID, nome = s.NmStatus, cor = s.CdCor }));
}

<div class="kanban-board" data-status-list="@statusListJson">
    @foreach (var status in statusColumns)
    {
        var columnTasks = rootTasks.Where(t => t.ProjetoTarefaStatusID == status.ProjetoTarefaStatusID).ToList();

        <div class="kanban-column" data-status-id="@status.ProjetoTarefaStatusID">
            <div class="kanban-column-header" style="border-top: 3px solid @status.CdCor;">
                <span class="fw-semibold" style="font-size: 0.85rem;">@status.NmStatus</span>
                <span class="badge rounded-pill kanban-column-count" style="background: color-mix(in srgb, @status.CdCor 20%, transparent); color: @status.CdCor; font-size: 0.7rem;">
                    @columnTasks.Count
                </span>
            </div>
            <div class="kanban-column-body @(podeEditar ? "kanban-droppable" : "")" data-status-id="@status.ProjetoTarefaStatusID">
                @foreach (var tarefa in columnTasks)
                {
                    var subTarefas = tarefa.SubTarefas;
                    var subCount = subTarefas.Count;
                    var subDone = subTarefas.Count(s => s.ProjetoTarefaStatusID == concluidoStatusId);
                    var subPct = subCount > 0 ? (int)Math.Round((double)subDone / subCount * 100) : 0;

                    <div class="kanban-card @(podeEditar ? "kanban-draggable" : "")"
                         @(podeEditar ? "draggable=true" : "")
                         data-tarefa-id="@tarefa.ProjetoTarefaID"
                         data-projeto-id="@tarefa.ProjetoID"
                         data-nm-tarefa="@tarefa.NmTarefa"
                         data-ds-tarefa="@tarefa.DsTarefa"
                         data-status-id="@tarefa.ProjetoTarefaStatusID"
                         data-prioridade-id="@tarefa.ProjetoTarefaPrioridadeID"
                         data-responsavel-id="@tarefa.UsuarioResponsavelID"
                         data-nm-responsavel="@tarefa.NmResponsavel"
                         data-dt-inicio="@tarefa.DtInicio"
                         data-dt-previsao-fim="@tarefa.DtPrevisaoFim"
                         data-dt-fim-real="@tarefa.DtFimReal"
                         data-subtarefas='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(subTarefas.Select(s => new { id = s.ProjetoTarefaID, nome = s.NmTarefa, statusId = s.ProjetoTarefaStatusID, nmStatus = s.NmStatus, corStatus = s.CdCorStatus })))'>
                        <div class="kanban-card-title">@tarefa.NmTarefa</div>
                        <div class="kanban-card-meta">
                            <span class="kanban-card-badge" style="background: color-mix(in srgb, @tarefa.CdCorPrioridade 18%, transparent); color: @tarefa.CdCorPrioridade;">
                                <i class="fa-solid fa-flag" style="font-size: 0.5rem;"></i> @tarefa.NmPrioridade
                            </span>
                            @if (subCount > 0)
                            {
                                <button type="button" class="kanban-card-subtask-count kanban-btn-ver-subtarefas" title="@subDone de @subCount subtarefas concluídas">
                                    <i class="fa-solid fa-list-check" style="font-size: 0.55rem;"></i> @subDone/@subCount
                                </button>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(tarefa.DtPrevisaoFim) || !string.IsNullOrWhiteSpace(tarefa.NmResponsavel))
                        {
                            <div class="kanban-card-footer">
                                @if (!string.IsNullOrWhiteSpace(tarefa.DtPrevisaoFim))
                                {
                                    <span class="kanban-card-date" title="Prazo">
                                        <i class="fa-solid fa-calendar-check"></i> @tarefa.DtPrevisaoFim
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(tarefa.NmResponsavel))
                                {
                                    <span class="kanban-card-responsavel" title="@tarefa.NmResponsavel">
                                        <i class="fa-solid fa-user"></i>
                                    </span>
                                }
                            </div>
                        }

                        @if (podeEditar)
                        {
                            <button type="button" class="kanban-btn-add-subtask" title="Criar subtarefa" aria-label="Criar subtarefa">
                                <i class="fa-solid fa-plus"></i> Subitem
                            </button>
                            <div class="kanban-inline-form d-none" data-inline-type="subtask" data-tarefa-pai-id="@tarefa.ProjetoTarefaID" role="form" aria-label="Criar subtarefa">
                                <input type="text" class="kanban-inline-input" placeholder="Título da subtarefa..." maxlength="200" aria-label="Título da subtarefa" />
                                <div class="kanban-inline-actions">
                                    <button type="button" class="kanban-inline-btn-confirm" title="Confirmar criação"><i class="fa-solid fa-check"></i> Criar</button>
                                    <button type="button" class="kanban-inline-btn-cancel" title="Cancelar"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (columnTasks.Count == 0)
                {
                    <div class="kanban-empty-placeholder">
                        <small class="text-muted">Nenhuma tarefa</small>
                    </div>
                }
            </div>
            @if (podeEditar)
            {
                <div class="kanban-column-footer">
                    <div class="kanban-inline-form d-none" data-inline-type="task" data-status-id="@status.ProjetoTarefaStatusID" role="form" aria-label="Criar tarefa">
                        <input type="text" class="kanban-inline-input" placeholder="Título da tarefa..." maxlength="200" aria-label="Título da tarefa" />
                        <div class="kanban-inline-actions">
                            <button type="button" class="kanban-inline-btn-confirm" title="Confirmar criação"><i class="fa-solid fa-check"></i> Criar</button>
                            <button type="button" class="kanban-inline-btn-cancel" title="Cancelar"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    </div>
                    <button type="button" class="kanban-btn-add-task" data-status-id="@status.ProjetoTarefaStatusID" title="Criar tarefa nesta coluna" aria-label="Criar tarefa">
                        <i class="fa-solid fa-plus"></i> Tarefa
                    </button>
                </div>
            }
        </div>
    }
</div>
