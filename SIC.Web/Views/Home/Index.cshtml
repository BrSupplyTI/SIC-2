                            </thead>
                            <tbody>
                                <tr>
                                    <td><i class="fa-duotone fa-box-open me-2 text-br"></i>Pedido #84521 aprovado</td>
                                    <td>Comercial</td>
                                    <td class="text-center"><span class="badge-status badge-status-success"><i class="fa-solid fa-check me-1"></i>Concluído</span></td>
