                    </div>
                    <div class="text-center">
                        <small class="text-muted d-block">Frete</small>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Frete) || Model.Frete == "R$ 0,00" ? "CIF" : Model.Frete)</strong>
