    <script>
        window.cotacaoConfig = {
            propostaId:        @Model.PropostaID,
            clienteId:         @Model.ClienteID,
            statusId:          @Model.StatusID,
            usuarioId:         @Model.ConsultorUsuarioID,
            tabelaPrecoId:     @tabelaPrecoIdInt,
            estabelecimentoId: @Model.EstabelecimentoID,
            intranetUrl:       '@(Config["AppSettings:IntranetBaseUrl"] ?? "http://localhost")',
            itens:             @Html.Raw(itensJson),
            urls: {
                buscarCatalogo:            '@Url.Action("BuscarCatalogo",           "Cotacao", new { propostaId = Model.PropostaID })',
                adicionarItem:             '@Url.Action("AdicionarItem",            "Cotacao", new { propostaId = Model.PropostaID })',
                atualizarCusto:            '@Url.Action("AtualizarCustoItem",       "Cotacao", new { propostaId = Model.PropostaID, propostaItemId = "{itemId}" })',
                atualizarItem:             '@Url.Action("AtualizarItem",            "Cotacao", new { propostaId = Model.PropostaID, propostaItemId = "{itemId}" })',
                gerarItens:                '@Url.Action("GerarItens",                "Cotacao", new { propostaId = Model.PropostaID })',
                removerItens:              '@Url.Action("RemoverItens",              "Cotacao", new { propostaId = Model.PropostaID })',
                impostosItem:              `/Cotacao/@Model.PropostaID/itens/{itemId}/impostos`,
                validarItensImportacao:    '@Url.Action("ValidarItensImportacao",   "Cotacao", new { propostaId = Model.PropostaID })',
                salvarCondPagto:           '@Url.Action("SalvarCondPagto",           "Cotacao", new { propostaId = Model.PropostaID })',
                aprovar:                   '@Url.Action("Aprovar",                   "Cotacao", new { propostaId = Model.PropostaID })',
                reprovar:                  '@Url.Action("Reprovar",                  "Cotacao", new { propostaId = Model.PropostaID })',
                calcularMargem:            '@Url.Action("CalcularMargemItem",       "Cotacao", new { propostaId = Model.PropostaID, propostaItemId = 0 })',
                calcularFrete:             '@Url.Action("CalcularFrete",             "Cotacao", new { propostaId = Model.PropostaID })',
                salvarFrete:               '@Url.Action("SalvarFrete",               "Cotacao", new { propostaId = Model.PropostaID })',
                gerarPdf:                  '@Url.Action("GerarPdf",                  "Cotacao", new { propostaId = Model.PropostaID })',
                gerarExcel:                `/Cotacao/@Model.PropostaID/gerar-excel`,
                finalizar:                 '@Url.Action("Finalizar",                 "Cotacao", new { propostaId = Model.PropostaID })',
                autorizarFaturamento:      '@Url.Action("AutorizarFaturamento",      "Cotacao", new { propostaId = Model.PropostaID })'
            }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/Cotacao/cotacao-view.js" asp-append-version="true"></script>
    <script>
        (function () {
            async function gerarPdf(comImpostos) {
                const comFoto = document.getElementById('chkComFoto').checked;
                const baseUrl = cotacaoConfig.urls?.gerarPdf || `/Cotacao/${cotacaoConfig.propostaId}/gerar-pdf`;
                const url = `${baseUrl}?comFoto=${comFoto}&comImpostos=${comImpostos}`;
                const btnId = comImpostos ? 'btnPdfComImp' : 'btnPdfSemImp';
                const btn = document.getElementById(btnId);
                const originalHtml = btn.innerHTML;

                btn.disabled = true;
                btn.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Gerando...';

                try {
                    console.log('[PDF] Clicou em:', btnId);
                    console.log('[PDF] URL:', url);
                    console.log('[PDF] comFoto:', comFoto, 'comImpostos:', comImpostos);
                    const resp = await fetch(url, { method: 'POST' });
                    console.log('[PDF] Status resposta:', resp.status);
                    if (!resp.ok) {
                        const errorText = await resp.text();
                        console.error('[PDF] Erro (HTTP ' + resp.status + '):', errorText);
                        throw new Error(`HTTP ${resp.status}: ${errorText}`);
                    }

                    const blob = await resp.blob();
                    const objUrl = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    const cd = resp.headers.get('content-disposition') ?? '';
                    const match = cd.match(/filename[^;=\n]*=(['"]?)([^'"\n;]+)\1/);
                    a.download = match ? match[2].trim() : 'Proposta.pdf';
                    a.href = objUrl;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(objUrl);

                    console.log('[PDF] Sucesso! PDF gerado');
                    bootstrap.Modal.getInstance(document.getElementById('modalGerarPDF'))?.hide();
                } catch (err) {
                    console.error('[PDF] Erro capturado:', err.message);
                    alert('Erro ao gerar PDF: ' + err.message);
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            document.getElementById('btnPdfSemImp')?.addEventListener('click', () => gerarPdf(false));
            document.getElementById('btnPdfComImp')?.addEventListener('click', () => gerarPdf(true));
        })();
    </script>
