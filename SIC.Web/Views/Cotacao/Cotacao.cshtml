                @if (Model.StatusID == 2)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.ClienteCodigo) && Model.ClienteCodigo != "AGUARDANDO")
                    {
                        <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalAutorizarFaturamento" title="Autorizar Faturamento">
                            <i class="fa-solid fa-circle-check me-1"></i>Autorizar Faturamento
