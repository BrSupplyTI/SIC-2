                        <div class="form-text text-muted">Digite o número do Pedido para gerar os itens</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success" id="btnConfirmarGeracao">
                        <i class="fa-solid fa-check me-1"></i>Gerar Itens
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const formGerarCotacao = document.getElementById('formGerarCotacao');
    const inputTipoGeracao = document.getElementById('inputTipoGeracao');
    const inputCotacaoID = document.getElementById('inputCotacaoID');
    const btnConfirmarGeracao = document.getElementById('btnConfirmarGeracao');
    const modalGerarCotacao = document.getElementById('modalGerarCotacao');

    formGerarCotacao.addEventListener('submit', async function (e) {
        e.preventDefault();

        const tipoGeracao = inputTipoGeracao.value;
        const cotacaoID = inputCotacaoID.value.trim();

        if (!tipoGeracao || !cotacaoID) {
            Swal.fire({ icon: 'warning', title: 'Atenção', text: 'Preencha todos os campos obrigatórios.' });
            return;
        }

        btnConfirmarGeracao.disabled = true;
        const originalHtml = btnConfirmarGeracao.innerHTML;
        btnConfirmarGeracao.innerHTML = '<i class="fa-duotone fa-spinner fa-spin me-1"></i>Gerando...';

        try {
            const payload = {
                tipoGeracao: tipoGeracao,
                cotacaoID: cotacaoID
            };

            const urlGerar = window.cotacaoConfig?.urls?.gerarItens || `/Cotacao/${window.cotacaoConfig.propostaId}/gerar-itens`;
            const resp = await fetch(urlGerar, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const json = await resp.json();

            if (!resp.ok || !json.success) {
                throw new Error(json.error ?? json.message ?? `HTTP ${resp.status}`);
            }

            bootstrap.Modal.getInstance(modalGerarCotacao)?.hide();

            await Swal.fire({
                icon: 'success',
                title: 'Itens Gerados!',
                text: 'Itens carregados com sucesso.',
                confirmButtonText: 'OK'
            });

            window.location.reload();
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Erro', text: 'Erro ao gerar itens: ' + err.message });
        } finally {
            btnConfirmarGeracao.disabled = false;
            btnConfirmarGeracao.innerHTML = originalHtml;
        }
    });
})();
</script>

