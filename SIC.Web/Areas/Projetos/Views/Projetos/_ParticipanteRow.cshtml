@model SIC.Web.Areas.Projetos.Models.ProjetoParticipanteItemVm
@{
    var avatarColors = new[] { "#0d6efd", "#198754", "#fd7e14", "#6f42c1", "#dc3545", "#20c997", "#0dcaf0", "#6c757d" };
    var colorIndex = (int)(ViewData["Index"] ?? 0);
    var color = avatarColors[colorIndex % avatarColors.Length];
    var podeEditar = ViewData["PodeEditar"] is true;
    var usuarioCriadorID = (int)(ViewData["UsuarioCriadorID"] ?? 0);
    var isCriador = Model.UsuarioID == usuarioCriadorID;

    // Busca o ícone do papel do catálogo
    var papelItem = SIC.Web.Areas.Projetos.Models.ProjetoPapeisDisponiveis.Todos
        .FirstOrDefault(p => string.Equals(p.Nome, Model.NmPapel, StringComparison.OrdinalIgnoreCase));
    var papelIcone = papelItem?.Icone ?? "fa-solid fa-user-tag";

    string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
    }
}

<div class="participante-card @(isCriador ? "participante-card--criador" : "")">
    <div class="participante-card-main">
        <div class="participante-avatar" style="background: linear-gradient(135deg, @color, color-mix(in srgb, @color 70%, #000));">
            @GetInitials(Model.NmUsuario)
        </div>
        <div class="participante-info">
            <div class="participante-nome">
                <span class="participante-nome-text" title="@Model.NmUsuario">@Model.NmUsuario</span>
                @if (isCriador)
                {
                    <span class="participante-badge-criador" title="Criador do projeto">
                        <i class="fa-solid fa-crown"></i>
                    </span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.NmPapel))
            {
                <div class="participante-papel">
                    <i class="@papelIcone participante-papel-icon"></i>
                    <span>@Model.NmPapel</span>
                </div>
            }
            else
            {
                <div class="participante-papel participante-papel--empty">
                    <i class="fa-solid fa-user-tag participante-papel-icon"></i>
                    <span>Sem papel definido</span>
                </div>
            }
        </div>
    </div>
    <div class="participante-card-meta">
        <div class="participante-data" title="Data de entrada no projeto">
            <i class="fa-solid fa-calendar-day"></i>
            <span>@Model.DtEntrada</span>
        </div>
        @if (podeEditar && !isCriador)
        {
            <div class="participante-actions">
                <button type="button" class="participante-action-btn participante-action-btn--danger btn-remover-participante" title="Remover participante"
                        data-participante-id="@Model.ProjetoParticipanteID"
                        data-nm-usuario="@Model.NmUsuario">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </div>
        }
    </div>
</div>
