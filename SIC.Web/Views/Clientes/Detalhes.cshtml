                                    </div>
                                </div>
                            </div>
                            <p class="text-muted mb-2 fs-7">Situação:</p>
                            <div class="tit-filter-bar mb-2" id="titFilterBar"></div>
                            <div class="table-responsive">
                                <table class="table table-sm styled-table align-middle mb-0" id="tblTitulos" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th data-priority="9" class="text-center">Emissão</th>
                                            <th data-priority="1" class="text-center">Nota Fiscal</th>
                                            <th data-priority="6" class="text-center">Série</th>
                                            <th data-priority="8" class="text-center">Pedido</th>
                                            <th data-priority="7" class="text-center">Parcela</th>
                                            <th data-priority="2" class="text-center">Vencimento</th>
                                            <th data-priority="3" class="text-center">Situação</th>
                                            <th data-priority="5" class="text-end">Valor Original</th>
                                            <th data-priority="4" class="text-end">Valor Saldo</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingEnderecos">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEnderecos" aria-expanded="false" aria-controls="collapseEnderecos">
                        <i class="fa-duotone fa-thin fa-map-location-dot me-3 produto-accordion-icon"></i> Endereços
                        <span class="badge rounded-pill bg-secondary ms-2">@Model.QtEnderecos</span>
                    </button>
                </h2>
                <div id="collapseEnderecos" class="accordion-collapse collapse" aria-labelledby="headingEnderecos" data-bs-parent="#clienteDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="text-center text-muted py-4 d-none" id="enderecosLoader">
                            <div class="spinner-border text-primary mb-2" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <div>Carregando dados...</div>
                        </div>
                        <div class="alert alert-danger d-none" id="enderecosError" role="alert">
                            Não foi possível carregar os endereços
                        </div>
                        <div class="alert alert-secondary d-none" id="enderecosEmpty">
                            Nenhum endereço encontrado.
                        </div>
                        <div class="d-none" id="divTblEnderecos">
                            <p class="text-muted mb-2 fs-7">Situação:</p>
                            <div class="tit-filter-bar mb-2" id="enderecosFilterBar"></div>
                            <div class="table-responsive">
                                <table class="table table-sm styled-table align-middle mb-0" id="tblEnderecos" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th data-priority="11" class="text-center">ID</th>
                                            <th data-priority="2" class="text-center">Situação</th>
                                            <th data-priority="1" class="text-center">Cód. SAP</th>
                                            <th data-priority="7" class="text-center">Docto.</th>
                                            <th data-priority="5" class="text-center">Documento</th>
                                            <th data-priority="8" class="text-start">Razão Social</th>
                                            <th data-priority="3" class="text-start">Cidade</th>
                                            <th data-priority="4" class="text-center">UF</th>
                                            <th data-priority="6" class="text-start">Tabela de Preços</th>
                                            <th data-priority="9" class="text-end">Pedido Mínimo</th>
                                            <th data-priority="10" class="text-end">Taxa Entrega</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingLocais">
                    <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLocais" aria-expanded="false" aria-controls="collapseLocais">
                        <i class="fa-duotone fa-thin fa-home-alt me-3 produto-accordion-icon"></i> Locais de Entrega
                        <span class="badge rounded-pill bg-secondary ms-2">@Model.QtLocaisEntrega</span>
                    </button>
                </h2>
                <div id="collapseLocais" class="accordion-collapse collapse" aria-labelledby="headingLocais" data-bs-parent="#clienteDetalhesAccordion">
                    <div class="accordion-body">
                        <div class="text-center text-muted py-4 d-none" id="locaisLoader">
                            <div class="spinner-border text-primary mb-2" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <div>Carregando dados...</div>
                        </div>
                        <div class="alert alert-danger d-none" id="locaisError" role="alert">
                            Não foi possível carregar os locais de entrega
                        </div>
                        <div class="alert alert-secondary d-none" id="locaisEmpty">
                            Nenhum local de entrega encontrado.
                        </div>
                        <div class="d-none" id="divTblLocais">
                            <p class="text-muted mb-2 fs-7">Situação:</p>
                            <div class="tit-filter-bar mb-2" id="locaisFilterBar"></div>
                            <div class="table-responsive">
                                <table class="table table-sm styled-table align-middle mb-0" id="tblLocais" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th data-priority="6" class="text-center">ID</th>
                                            <th data-priority="2" class="text-center">Situação</th>
                                            <th data-priority="1" class="text-center">Cód. Controle</th>
                                            <th data-priority="7" class="text-start">Nome do Local</th>
                                            <th data-priority="8" class="text-center">Docto.</th>
                                            <th data-priority="5" class="text-center">Documento</th>
                                            <th data-priority="3" class="text-start">Cidade</th>
                                            <th data-priority="4" class="text-center">UF</th>
                                            <th data-priority="10" class="text-center">Canal de Venda</th>
                                            <th data-priority="9" class="text-center">Situacao Crédito</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (@Model.QtUsuarios > 0)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingUsuarios">
                        <button class="accordion-button fw-semibold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsuarios" aria-expanded="false" aria-controls="collapseUsuarios">
                            <i class="fa-duotone fa-thin fa-users me-3 produto-accordion-icon"></i> Usuários
                            <span class="badge rounded-pill bg-secondary ms-2">@Model.QtUsuarios</span>
                        </button>
                    </h2>
                    <div id="collapseUsuarios" class="accordion-collapse collapse" aria-labelledby="headingUsuarios" data-bs-parent="#clienteDetalhesAccordion">
                        <div class="accordion-body">
                            <div class="text-center text-muted py-4 d-none" id="usuariosLoader">
                                <div class="spinner-border text-primary mb-2" role="status">
                                    <span class="visually-hidden">Carregando...</span>
                                </div>
                                <div>Carregando dados...</div>
                            </div>
                            <div class="alert alert-danger d-none" id="usuariosError" role="alert">
                                Não foi possível carregar os usuários
                            </div>
                            <div class="alert alert-secondary d-none" id="usuariosEmpty">
                                Nenhum usuário encontrado.
                            </div>
                            <div class="d-none" id="divTblUsuarios">
