/* ============================================
   Cotações — Listagem
   Alinhado com o design system SIC
   ============================================ */

/* ── Section title ── */
.cotacao-section-title {
    font-size: .8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--sic-muted);
    border-bottom: 1px solid var(--sic-border);
    padding-bottom: .5rem;
    margin-bottom: 1rem;
}

/* ── Table wrapper ── */
.table-cotacao-wrap {
    border: 1px solid var(--sic-border);
    border-radius: .5rem;
    overflow: hidden;
}

/* ── Table base ── */
.table-cotacao {
    --bs-table-bg: transparent;
    --bs-table-hover-bg: var(--sic-surface-2);
}

.table-cotacao thead th {
    font-size: .7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--sic-muted);
    background: var(--sic-surface-2);
    border-bottom: 2px solid var(--sic-border);
    padding: .55rem .75rem;
    white-space: nowrap;
}

.table-cotacao tbody td {
    color: var(--sic-text);
    border-bottom: 1px solid var(--sic-border);
    padding: .5rem .75rem;
    font-size: .85rem;
    vertical-align: middle;
}

.table-cotacao tbody tr:last-child td {
    border-bottom: none;
}

/* ── Action buttons ── */
.cotacao-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    font-size: .8rem;
    font-weight: 600;
    padding: .45rem 1rem;
    border-radius: .375rem;
    border: 1px solid transparent;
    transition: all .2s ease;
    cursor: pointer;
}

.cotacao-btn i {
    font-size: .85rem;
}

.cotacao-btn-abrir,
.cotacao-btn-exibir {
    background: rgba(var(--bs-primary-rgb), .12);
    color: var(--sic-text);
    border-color: rgba(var(--bs-primary-rgb), .3);
    text-decoration: none !important;
}

.cotacao-btn-abrir:hover,
.cotacao-btn-exibir:hover {
    background: rgba(var(--bs-primary-rgb), .25);
    border-color: rgba(var(--bs-primary-rgb), .5);
}

/* ── Paginação DataTables — estilo laranja (idêntico ao PrePedidosPDF) ── */
#cotacoesTable_wrapper .dt-paging {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
}

#cotacoesTable_wrapper .dt-paging .dt-paging-button {
    min-width: 2.5rem;
    padding: .3rem .6rem;
    margin: 0 .15rem;
    font-size: .8rem;
    font-weight: 500;
    text-align: center;
    border-radius: .375rem;
    border: 1px solid var(--sic-border);
    background-color: var(--sic-surface-2);
    color: var(--sic-text);
    cursor: pointer;
    transition: all .2s ease;
    text-decoration: none;
    display: inline-block;
}

#cotacoesTable_wrapper .dt-paging .dt-paging-button:hover:not(.disabled) {
    background-color: color-mix(in srgb, var(--sic-brand) 15%, transparent);
    border-color: var(--sic-brand);
    color: var(--sic-brand);
}

#cotacoesTable_wrapper .dt-paging .dt-paging-button.current {
    background-color: var(--sic-brand) !important;
    border-color: var(--sic-brand) !important;
    color: #ffffff !important;
    font-weight: 600;
}

#cotacoesTable_wrapper .dt-paging .dt-paging-button.disabled {
    background-color: var(--sic-surface-2);
    border-color: var(--sic-border);
    color: var(--sic-muted);
    opacity: .5;
    cursor: not-allowed;
    pointer-events: none;
}

/* Esconde a busca nativa do DataTables caso apareça */
#cotacoesTable_wrapper .dt-search {
    display: none;
}

/* Esconde informações de paginação (ex: "Mostrando 1 até 25 de 100") */
#cotacoesTable_wrapper .dt-info {
    display: none;
}

/* Ajuste para wrapper do DataTables */
#cotacoesTable_wrapper {
    width: 100%;
}
