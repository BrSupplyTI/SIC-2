<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIC.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fontawesome7/css/all.min.css" asp-append-version="true" />
</head>
<body>
    <div class="login-video-background bg-black">
        <video autoplay muted loop playsinline>
            <source src="~/mp4/login.mp4" type="video/mp4" />
        </video>
        <div class="login-video-overlay"></div>
    </div>

    <div class="container py-4 py-md-5 login-shell">
        <div class="login-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
