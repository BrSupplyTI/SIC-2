        const v2 = (val2 !== null && val2 !== undefined) ? 'R$ ' + Number(val2).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
        return v1 + '<br>' + v2;
