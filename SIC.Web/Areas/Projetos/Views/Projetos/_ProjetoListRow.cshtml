@model SIC.Web.Areas.Projetos.Models.ProjetoItemComTarefasVm
@{
    var pct = Model.QtTarefas > 0 ? (int)Math.Round(Model.QtTarefasConcluidas * 100.0 / Model.QtTarefas) : 0;
    var progressColor = pct == 100 ? "#198754" : pct >= 50 ? "#0d6efd" : "#ffc107";
    var hasTarefas = Model.Tarefas.Count > 0;
}

<div class="projeto-list-row" style="border-left-color: @Model.CdCorStatus;">
    <!-- Header do projeto -->
    <div class="projeto-list-header">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
            @if (hasTarefas)
            {
                <button type="button" class="btn btn-sm btn-link p-0 projeto-list-toggle"
                        data-target="projeto-tarefas-@Model.ProjetoID" title="Expandir tarefas (@Model.Tarefas.Count)">
                    <i class="fa-solid fa-chevron-right text-muted projeto-list-chevron"></i>
                </button>
            }
            else
            {
                <span class="projeto-list-spacer"></span>
            }

            <a href="@Url.Action("Detalhes", "Projetos", new { area = "Projetos", projetoId = Model.ProjetoID })"
               class="projeto-list-nome fw-semibold text-decoration-none">
                @Model.NmProjeto
            </a>

            @if (Model.QtTarefas > 0)
            {
                <span class="projeto-list-task-count" title="@Model.QtTarefas tarefa(s)">
                    @Model.QtTarefas
                </span>
            }
        </div>

        <div class="projeto-list-header-meta">
            <div class="projeto-list-header-info">
                <span class="projeto-list-badge"
                      style="background: color-mix(in srgb, @Model.CdCorStatus 15%, transparent); color: @Model.CdCorStatus; border: 1px solid color-mix(in srgb, @Model.CdCorStatus 25%, transparent);">
                    <i class="fa-solid fa-circle" style="font-size: 0.35rem;"></i> @Model.NmStatus
                </span>

                <div class="projeto-list-progress" title="@Model.QtTarefasConcluidas de @Model.QtTarefas tarefas concluídas">
                    <div class="projeto-progress flex-grow-1">
                        <div class="projeto-progress-bar" style="width: @pct%; background: @progressColor;"></div>
                    </div>
                    <small class="text-muted">@Model.QtTarefasConcluidas/@Model.QtTarefas</small>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.DtPrevisaoFim))
                {
                    <span class="projeto-list-date projeto-list-date-header d-none d-lg-inline-flex" title="Previsão de término">
                        <i class="fa-solid fa-calendar-check"></i>@Model.DtPrevisaoFim
                    </span>
                }
            </div>

            <div class="projeto-list-header-people">
                @{
                    var iniciaisCriador = string.Join("", Model.NmCriador.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
                }
                <span class="projeto-list-avatar d-none d-md-inline-flex" title="Criador: @Model.NmCriador">@iniciaisCriador</span>

                @if (Model.QtParticipantes > 0)
                {
                    <span class="projeto-list-participants d-none d-lg-inline-flex" title="@Model.QtParticipantes participante(s)">
                        <i class="fa-solid fa-users"></i> @Model.QtParticipantes
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Tarefas (recolhido por padrão) -->
    @if (hasTarefas)
    {
        <div class="projeto-list-tarefas d-none" id="projeto-tarefas-@Model.ProjetoID">
            @foreach (var tarefa in Model.Tarefas)
            {
                <div class="projeto-list-tarefa"
                     data-tarefa-id="@tarefa.ProjetoTarefaID"
                     data-projeto-id="@Model.ProjetoID"
                     data-nm-tarefa="@tarefa.NmTarefa"
                     data-ds-tarefa="@tarefa.DsTarefa"
                     data-status-id="@tarefa.ProjetoTarefaStatusID"
                     data-prioridade-id="@tarefa.ProjetoTarefaPrioridadeID"
                     data-responsavel-id="@(tarefa.UsuarioResponsavelID?.ToString() ?? "")"
                     data-nm-responsavel="@tarefa.NmResponsavel"
                     data-dt-inicio="@tarefa.DtInicio"
                     data-dt-previsao-fim="@tarefa.DtPrevisaoFim"
                     data-dt-fim-real="@tarefa.DtFimReal">
                    <div class="projeto-list-tarefa-content">
                        @if (tarefa.SubTarefas.Count > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 projeto-list-toggle"
                                    data-target="projeto-subtarefas-@tarefa.ProjetoTarefaID" title="Expandir subtarefas (@tarefa.SubTarefas.Count)">
                                <i class="fa-solid fa-chevron-right text-muted projeto-list-chevron projeto-list-chevron-sm"></i>
                            </button>
                        }
                        else
                        {
                            <span class="projeto-list-spacer-sm"></span>
                        }

                        <span class="projeto-list-tarefa-nome">@tarefa.NmTarefa</span>

                        <div class="projeto-list-tarefa-meta">
                            <div class="projeto-list-tarefa-badges">
                                <button type="button" class="projeto-list-status-trigger"
                                        style="background: color-mix(in srgb, @tarefa.CdCorStatus 18%, transparent); color: @tarefa.CdCorStatus;"
                                        title="Alterar status">
                                    <i class="fa-solid fa-circle" style="font-size: 0.4rem;"></i> @tarefa.NmStatus
                                    <i class="fa-solid fa-caret-down projeto-list-trigger-caret"></i>
                                </button>
                                <button type="button" class="projeto-list-prioridade-trigger"
                                        style="background: color-mix(in srgb, @tarefa.CdCorPrioridade 18%, transparent); color: @tarefa.CdCorPrioridade;"
                                        title="Alterar prioridade">
                                    <i class="fa-solid fa-flag" style="font-size: 0.5rem;"></i> @tarefa.NmPrioridade
                                    <i class="fa-solid fa-caret-down projeto-list-trigger-caret"></i>
                                </button>
                            </div>
                            <div class="projeto-list-tarefa-info">
                                @if (!string.IsNullOrWhiteSpace(tarefa.DtPrevisaoFim))
                                {
                                    var dateClass = "projeto-list-date";
                                    var dateIcon = "fa-solid fa-calendar-check";
                                    if (DateTime.TryParse(tarefa.DtPrevisaoFim, out var dtPrazo))
                                    {
                                        var diasRestantes = (dtPrazo.Date - DateTime.Today).TotalDays;
                                        if (diasRestantes < 0)
                                        {
                                            dateClass += " projeto-list-date-overdue";
                                            dateIcon = "fa-solid fa-triangle-exclamation";
                                        }
                                        else if (diasRestantes <= 3)
                                        {
                                            dateClass += " projeto-list-date-soon";
                                            dateIcon = "fa-solid fa-clock";
                                        }
                                    }
                                    <span class="@dateClass" title="Prazo: @tarefa.DtPrevisaoFim">
                                        <i class="@dateIcon"></i> @tarefa.DtPrevisaoFim
                                    </span>
                                }
                                else
                                {
                                    <span class="projeto-list-date projeto-list-date-placeholder" title="Sem prazo definido">
                                        <i class="fa-solid fa-calendar"></i> Sem prazo
                                    </span>
                                }
                                @if (tarefa.UsuarioResponsavelID.HasValue && !string.IsNullOrWhiteSpace(tarefa.NmResponsavel))
                                {
                                    var nomeParts = tarefa.NmResponsavel.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                    var iniciais = nomeParts.Length >= 2
                                        ? $"{nomeParts[0][0]}{nomeParts[^1][0]}"
                                        : nomeParts[0][..Math.Min(2, nomeParts[0].Length)];
                                    <span class="projeto-list-responsavel" title="@tarefa.NmResponsavel — Clique para alterar">@iniciais.ToUpper()</span>
                                }
                                else
                                {
                                    <button type="button" class="projeto-list-btn-responsavel" title="Adicionar responsável" aria-label="Adicionar responsável">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (tarefa.SubTarefas.Count > 0)
                    {
                        <div class="projeto-list-subtarefas d-none" id="projeto-subtarefas-@tarefa.ProjetoTarefaID">
                            @foreach (var sub in tarefa.SubTarefas)
                            {
                                <div class="projeto-list-subtarefa"
                                     data-subtask-id="@sub.ProjetoTarefaID"
                                     data-projeto-id="@Model.ProjetoID"
                                     data-subtask-status-id="@sub.ProjetoTarefaStatusID"
                                     data-subtask-nm-tarefa="@sub.NmTarefa"
                                     data-subtask-ds-tarefa="@sub.DsTarefa"
                                     data-subtask-prioridade-id="@sub.ProjetoTarefaPrioridadeID"
                                     data-subtask-dt-inicio="@sub.DtInicio"
                                     data-subtask-dt-previsao-fim="@sub.DtPrevisaoFim"
                                     data-subtask-dt-fim-real="@sub.DtFimReal"
                                     data-subtask-responsavel-id="@(sub.UsuarioResponsavelID?.ToString() ?? "")"
                                     data-subtask-nm-responsavel="@sub.NmResponsavel">
                                    <span class="projeto-list-subtarefa-nome">@sub.NmTarefa</span>
                                    <div class="projeto-list-subtarefa-meta">
                                        @if (!string.IsNullOrWhiteSpace(sub.DtPrevisaoFim))
                                        {
                                            var subDateClass = "projeto-list-date projeto-list-date-sub";
                                            var subDateIcon = "fa-solid fa-calendar-check";
                                            if (DateTime.TryParse(sub.DtPrevisaoFim, out var subDtPrazo))
                                            {
                                                var subDiasRestantes = (subDtPrazo.Date - DateTime.Today).TotalDays;
                                                if (subDiasRestantes < 0)
                                                {
                                                    subDateClass += " projeto-list-date-overdue";
                                                    subDateIcon = "fa-solid fa-triangle-exclamation";
                                                }
                                                else if (subDiasRestantes <= 3)
                                                {
                                                    subDateClass += " projeto-list-date-soon";
                                                    subDateIcon = "fa-solid fa-clock";
                                                }
                                            }
                                            <span class="@subDateClass" title="Prazo: @sub.DtPrevisaoFim">
                                                <i class="@subDateIcon"></i> @sub.DtPrevisaoFim
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="projeto-list-date projeto-list-date-sub projeto-list-date-placeholder" title="Sem prazo definido">
                                                <i class="fa-solid fa-calendar"></i> Sem prazo
                                            </span>
                                        }
                                        <button type="button" class="projeto-list-subtarefa-status-trigger"
                                                style="color: @sub.CdCorStatus;"
                                                title="Alterar status">
                                            <span class="projeto-list-subtarefa-status-dot" style="background: @sub.CdCorStatus;"></span>
                                            @sub.NmStatus
                                            <i class="fa-solid fa-caret-down"></i>
                                        </button>
                                        @if (sub.UsuarioResponsavelID.HasValue && !string.IsNullOrWhiteSpace(sub.NmResponsavel))
                                        {
                                            var subNomeParts = sub.NmResponsavel.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                            var subIniciais = subNomeParts.Length >= 2
                                                ? $"{subNomeParts[0][0]}{subNomeParts[^1][0]}"
                                                : subNomeParts[0][..Math.Min(2, subNomeParts[0].Length)];
                                            <span class="projeto-list-subtarefa-responsavel" title="@sub.NmResponsavel — Clique para alterar">@subIniciais.ToUpper()</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="projeto-list-subtarefa-btn-responsavel" title="Adicionar responsável" aria-label="Adicionar responsável">
                                                <i class="fa-solid fa-user-plus"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <button type="button" class="projeto-list-btn-add-subtask" title="Criar subtarefa" aria-label="Criar subtarefa">
                        <i class="fa-solid fa-plus"></i> Subitem
                    </button>
                    <div class="projeto-list-inline-form d-none" data-inline-type="subtask" data-tarefa-pai-id="@tarefa.ProjetoTarefaID" data-projeto-id="@Model.ProjetoID" role="form" aria-label="Criar subtarefa">
                        <input type="text" class="projeto-list-inline-input" placeholder="Título da subtarefa..." maxlength="200" aria-label="Título da subtarefa" />
                        <div class="projeto-list-inline-actions">
                            <button type="button" class="projeto-list-inline-btn-confirm" title="Confirmar criação"><i class="fa-solid fa-check"></i> Criar</button>
                            <button type="button" class="projeto-list-inline-btn-cancel" title="Cancelar"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
