<div class="modal fade" id="modalAbrirChamado" tabindex="-1" aria-labelledby="modalAbrirChamadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="@(Config["AppSettings:IntranetBaseUrl"])/html/gravaadminhelpdesk.php" method="post" target="_blank">
                <input type="hidden" name="InputOperacao" value="INS_CHAMADO" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAbrirChamadoLabel">
                        <i class="fa-solid fa-envelope me-2 text-br"></i>Abrir Chamado
